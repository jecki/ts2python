              (optional "?")
              (types
                (type
                  (basic_type "string"))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * An error type for language model specific errors."
          "	 *"
          "	 * Consumers of language models should check the code property to determine specific"
          "	 * failure causes, like `if(someError.code === vscode.LanguageModelError.NotFound.name) {...}`"
          "	 * for the case of referring to an unknown language model. For unspecified errors the `cause`-property"
          "	 * will contain the actual error."
          "	 */"
          "	")
        (interface
          (identifier "LanguageModelError")
          (extends
            (type_name
              (name "Error")))
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * The requestor does not have permissions to use this"
              "		 * language model"
              "		 */"
              "		")
            (function
              (qualifiers
                (static "static"))
              (identifier "NoPermissions")
              (arg_list
                (argument
                  (identifier "message")
                  (optional "?")
                  (types
                    (type
                      (basic_type "string")))))
              (types
                (type
                  (type_name
                    (name "LanguageModelError")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The requestor is blocked from using this language model."
              "		 */"
              "		")
            (function
              (qualifiers
                (static "static"))
              (identifier "Blocked")
              (arg_list
                (argument
                  (identifier "message")
                  (optional "?")
                  (types
                    (type
                      (basic_type "string")))))
              (types
                (type
                  (type_name
                    (name "LanguageModelError")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The language model does not exist."
              "		 */"
              "		")
            (function
              (qualifiers
                (static "static"))
              (identifier "NotFound")
              (arg_list
                (argument
                  (identifier "message")
                  (optional "?")
                  (types
                    (type
                      (basic_type "string")))))
              (types
                (type
                  (type_name
                    (name "LanguageModelError")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * A code that identifies this error."
              "		 *"
              "		 * Possible values are names of errors, like {@linkcode LanguageModelError.NotFound NotFound},"
              "		 * or `Unknown` for unspecified errors from the language model itself. In the latter case the"
              "		 * `cause`-property will contain the actual error."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "code")
              (types
                (type
                  (basic_type "string"))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Options for making a chat request using a language model."
          "	 *"
          "	 * @see {@link LanguageModelChat.sendRequest}"
          "	 */"
          "	")
        (interface
          (identifier "LanguageModelChatRequestOptions")
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * A human-readable message that explains why access to a language model is needed and what feature is enabled by it."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "justification")
              (optional "?")
              (types
                (type
                  (basic_type "string"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * A set of options that control the behavior of the language model. These options are specific to the language model"
              "		 * and need to be looked up in the respective documentation."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "modelOptions")
              (optional "?")
              (types
                (type
                  (mapped_type
                    (map_signature
                      (index_signature
                        (identifier "name")
                        (type
                          (basic_type "string")))
                      (types
                        (type
                          (basic_type "any"))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * An optional list of tools that are available to the language model. These could be registered tools available via"
              "		 * {@link lm.tools}, or private tools that are just implemented within the calling extension."
              "		 *"
              "		 * If the LLM requests to call one of these tools, it will return a {@link LanguageModelToolCallPart} in"
              "		 * {@link LanguageModelChatResponse.stream}. It's the caller's responsibility to invoke the tool. If it's a tool"
              "		 * registered in {@link lm.tools}, that means calling {@link lm.invokeTool}."
              "		 *"
              "		 * Then, the tool result can be provided to the LLM by creating an Assistant-type {@link LanguageModelChatMessage} with a"
              "		 * {@link LanguageModelToolCallPart}, followed by a User-type message with a {@link LanguageModelToolResultPart}."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "tools")
              (optional "?")
              (types
                (type
                  (array_of
                    (array_types
                      (array_type
                        (type_name
                          (name "LanguageModelChatTool"))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * 	The tool-selecting mode to use. {@link LanguageModelChatToolMode.Auto} by default."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "toolMode")
              (optional "?")
              (types
                (type
                  (type_name
                    (name "LanguageModelChatToolMode")))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * McpStdioServerDefinition represents an MCP server available by running"
          "	 * a local process and operating on its stdin and stdout streams. The process"
          "	 * will be spawned as a child process of the extension host and by default"
          "	 * will not run in a shell environment."
          "	 */"
          "	")
        (interface
          (identifier "McpStdioServerDefinition")
          (declarations_block
            (comment__
