        (comment__
          ""
          ""
          "	/**"
          "	 * Namespace for notebooks."
          "	 *"
          "	 * The notebooks functionality is composed of three loosely coupled components:"
          "	 *"
          "	 * 1. {@link NotebookSerializer} enable the editor to open, show, and save notebooks"
          "	 * 2. {@link NotebookController} own the execution of notebooks, e.g they create output from code cells."
          "	 * 3. NotebookRenderer present notebook output in the editor. They run in a separate context."
          "	 */"
          "	")
        (namespace
          (identifier "notebooks")
          (comment__
            ""
            ""
            "		/**"
            "		 * Creates a new notebook controller."
            "		 *"
            "		 * @param id Identifier of the controller. Must be unique per extension."
            "		 * @param notebookType A notebook type for which this controller is for."
            "		 * @param label The label of the controller."
            "		 * @param handler The execute-handler of the controller."
            "		 * @returns A new notebook controller."
            "		 */"
            "		")
          (function
            (qualifiers)
            (identifier "createNotebookController")
            (arg_list
              (argument
                (identifier "id")
                (types
                  (type
                    (basic_type "string"))))
              (argument
                (identifier "notebookType")
                (types
                  (type
                    (basic_type "string"))))
              (argument
                (identifier "label")
                (types
                  (type
                    (basic_type "string"))))
              (argument
                (identifier "handler")
                (optional "?")
                (types
                  (type
                    (func_type
                      (arg_list
                        (argument
                          (identifier "cells")
                          (types
                            (type
                              (array_of
                                (array_types
                                  (array_type
                                    (type_name
                                      (name "NotebookCell"))))))))
                        (argument
                          (identifier "notebook")
                          (types
                            (type
                              (type_name
                                (name "NotebookDocument")))))
                        (argument
                          (identifier "controller")
                          (types
                            (type
                              (type_name
                                (name "NotebookController"))))))
                      (types
                        (type
                          (basic_type "void"))
                        (type
                          (generic_type
                            (type_name
                              (name "Thenable"))
                            (type_parameters
                              (parameter_types
                                (parameter_type
                                  (basic_type "void"))))))))))))
            (types
              (type
                (type_name
                  (name "NotebookController")))))
          (comment__
            ""
            ""
            "		/**"
            "		 * Register a {@link NotebookCellStatusBarItemProvider cell statusbar item provider} for the given notebook type."
            "		 *"
            "		 * @param notebookType The notebook type to register for."
            "		 * @param provider A cell status bar provider."
            "		 * @returns A {@link Disposable} that unregisters this provider when being disposed."
            "		 */"
            "		")
          (function
            (qualifiers)
            (identifier "registerNotebookCellStatusBarItemProvider")
            (arg_list
              (argument
                (identifier "notebookType")
                (types
                  (type
                    (basic_type "string"))))
              (argument
                (identifier "provider")
                (types
                  (type
                    (type_name
                      (name "NotebookCellStatusBarItemProvider"))))))
            (types
              (type
                (type_name
                  (name "Disposable")))))
          (comment__
            ""
            ""
            "		/**"
            "		 * Creates a new messaging instance used to communicate with a specific renderer."
            "		 *"
            "		 * * *Note 1:* Extensions can only create renderer that they have defined in their `package.json`-file"
            "		 * * *Note 2:* A renderer only has access to messaging if `requiresMessaging` is set to `always` or `optional` in"
            "		 * its `notebookRenderer` contribution."
            "		 *"
            "		 * @param rendererId The renderer ID to communicate with"
            "		 * @returns A new notebook renderer messaging object."
            "		 */"
            "		")
          (function
            (qualifiers)
            (identifier "createRendererMessaging")
            (arg_list
              (argument
                (identifier "rendererId")
                (types
                  (type
                    (basic_type "string")))))
            (types
              (type
                (type_name
                  (name "NotebookRendererMessaging"))))))
        (comment__
