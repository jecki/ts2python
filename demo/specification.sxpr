                      (array_type
                        (types
                          (type
                            (type_name
                              (name "TextDocumentEdit")))
                          (type
                            (type_name
                              (name "CreateFile")))
                          (type
                            (type_name
                              (name "RenameFile")))
                          (type
                            (type_name
                              (name "DeleteFile"))))))))))))
        (comment__
          ""
          ""
