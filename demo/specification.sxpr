          (literal
            (integer "1")))))
    (comment__
      ""
      ""
      "/**"
      " * Represents programming constructs like variables, classes, interfaces etc."
      " * that appear in a document. Document symbols can be hierarchical and they"
      " * have two ranges: one that encloses their definition and one that points to"
      " * their most interesting range, e.g. the range of an identifier."
      " */"
      "")
    (interface
      (identifier "DocumentSymbol")
      (declarations_block
        (comment__
          ""
          ""
          "	/**"
          "	 * The name of this symbol. Will be displayed in the user interface and"
          "	 * therefore must not be an empty string or a string only consisting of"
          "	 * white spaces."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "name")
          (types
            (type
              (basic_type "string"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * More detail for this symbol, e.g. the signature of a function."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "detail")
          (optional "?")
          (types
            (type
              (basic_type "string"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * The kind of this symbol."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "kind")
          (types
            (type
              (type_name
                (name "SymbolKind")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Tags for this document symbol."
          "	 *"
          "	 * @since 3.16.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "tags")
          (optional "?")
          (types
            (type
              (array_of
                (array_types
                  (array_type
                    (type_name
                      (name "SymbolTag"))))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Indicates if this symbol is deprecated."
          "	 *"
          "	 * @deprecated Use tags instead"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "deprecated")
          (optional "?")
          (types
            (type
              (basic_type "boolean"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * The range enclosing this symbol not including leading/trailing whitespace"
          "	 * but everything else, like comments. This information is typically used to"
          "	 * determine if the client's cursor is inside the symbol to reveal the"
          "	 * symbol in the UI."
          "	 */"
          "	")
        (declaration
          (qualifiers)
