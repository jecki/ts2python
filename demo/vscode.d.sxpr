                      (basic_type "string"))))
                (argument
                  (identifier "options")
                  (types
                    (type
                      (type_name
                        (name "FormattingOptions")))))
                (argument
                  (identifier "token")
                  (types
                    (type
                      (type_name
                        (name "CancellationToken"))))))
