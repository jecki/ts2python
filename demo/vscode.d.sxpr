                        (parameter_type
                          (basic_type "boolean"))))))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * A notebook cell kind."
          "	 */"
          "	")
        (enum
          (identifier "NotebookCellKind")
          (comment__
            ""
            ""
            "		/**"
            "		 * A markup-cell is formatted source that is used for display."
            "		 */"
            "		")
          (item
            (identifier "Markup")
            (literal
              (integer "1")))
          (comment__
            ""
            ""
            "		/**"
            "		 * A code-cell is source that can be {@link NotebookController executed} and that"
            "		 * produces {@link NotebookCellOutput output}."
            "		 */"
            "		")
          (item
            (identifier "Code")
            (literal
              (integer "2"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Represents a cell of a {@link NotebookDocument notebook}, either a {@link NotebookCellKind.Code code}-cell"
          "	 * or {@link NotebookCellKind.Markup markup}-cell."
          "	 *"
          "	 * NotebookCell instances are immutable and are kept in sync for as long as they are part of their notebook."
          "	 */"
          "	")
        (interface
          (identifier "NotebookCell")
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * The index of this cell in its {@link NotebookDocument.cellAt containing notebook}. The"
              "		 * index is updated when a cell is moved within its notebook. The index is `-1`"
              "		 * when the cell has been removed from its notebook."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "index")
              (types
                (type
                  (basic_type "number"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The {@link NotebookDocument notebook} that contains this cell."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "notebook")
              (types
                (type
                  (type_name
                    (name "NotebookDocument")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The kind of this cell."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "kind")
              (types
                (type
                  (type_name
                    (name "NotebookCellKind")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The {@link TextDocument text} of this cell, represented as text document."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "document")
              (types
                (type
                  (type_name
                    (name "TextDocument")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The metadata of this cell. Can be anything but must be JSON-stringifyable."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "metadata")
              (types
                (type
                  (mapped_type
                    (map_signature
                      (index_signature
                        (readonly "readonly")
                        (identifier "key")
                        (type
                          (basic_type "string")))
                      (types
                        (type
                          (basic_type "any"))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The outputs of this cell."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "outputs")
              (types
                (type
                  (readonly "readonly")
                  (array_of
                    (array_types
                      (array_type
                        (type_name
                          (name "NotebookCellOutput"))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The most recent {@link NotebookCellExecutionSummary execution summary} for this cell."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "executionSummary")
              (types
                (type
                  (type_name
                    (name "NotebookCellExecutionSummary")))
                (type
                  (type_name
                    (name "undefined")))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Represents a notebook which itself is a sequence of {@link NotebookCell code or markup cells}. Notebook documents are"
          "	 * created from {@link NotebookData notebook data}."
          "	 */"
          "	")
        (interface
          (identifier "NotebookDocument")
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * The associated uri for this notebook."
              "		 *"
              "		 * *Note* that most notebooks use the `file`-scheme, which means they are files on disk. However, **not** all notebooks are"
              "		 * saved on disk and therefore the `scheme` must be checked before trying to access the underlying file or siblings on disk."
              "		 *"
              "		 * @see {@link FileSystemProvider}"
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "uri")
              (types
                (type
                  (type_name
                    (name "Uri")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The type of notebook."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "notebookType")
              (types
                (type
                  (basic_type "string"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The version number of this notebook (it will strictly increase after each"
              "		 * change, including undo/redo)."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "version")
              (types
                (type
                  (basic_type "number"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * `true` if there are unpersisted changes."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "isDirty")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Is this notebook representing an untitled file which has not been saved yet."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "isUntitled")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * `true` if the notebook has been closed. A closed notebook isn't synchronized anymore"
              "		 * and won't be re-used when the same resource is opened again."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "isClosed")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Arbitrary metadata for this notebook. Can be anything but must be JSON-stringifyable."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "metadata")
              (types
                (type
                  (mapped_type
                    (map_signature
                      (index_signature
                        (identifier "key")
