        (comment__
          ""
          ""
          "	/**"
          "	 * The configuration target"
          "	 */"
          "	")
        (enum
          (identifier "ConfigurationTarget")
          (comment__
            ""
            "		/**"
            "		 * Global configuration"
            "		 */"
            "		")
          (item
            (identifier "Global")
            (literal
              (integer "1")))
          (comment__
            ""
            ""
            "		/**"
            "		 * Workspace configuration"
            "		 */"
            "		")
          (item
            (identifier "Workspace")
            (literal
              (integer "2")))
          (comment__
            ""
            ""
            "		/**"
            "		 * Workspace folder configuration"
            "		 */"
            "		")
          (item
            (identifier "WorkspaceFolder")
            (literal
              (integer "3"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Represents the configuration. It is a merged view of"
          "	 *"
          "	 * - *Default Settings*"
          "	 * - *Global (User) Settings*"
          "	 * - *Workspace settings*"
          "	 * - *Workspace Folder settings* - From one of the {@link workspace.workspaceFolders Workspace Folders} under which requested resource belongs to."
          "	 * - *Language settings* - Settings defined under requested language."
          "	 *"
          "	 * The *effective* value (returned by {@linkcode WorkspaceConfiguration.get get}) is computed by overriding or merging the values in the following order:"
          "	 *"
          "	 * 1. `defaultValue` (if defined in `package.json` otherwise derived from the value's type)"
          "	 * 1. `globalValue` (if defined)"
          "	 * 1. `workspaceValue` (if defined)"
          "	 * 1. `workspaceFolderValue` (if defined)"
          "	 * 1. `defaultLanguageValue` (if defined)"
          "	 * 1. `globalLanguageValue` (if defined)"
          "	 * 1. `workspaceLanguageValue` (if defined)"
          "	 * 1. `workspaceFolderLanguageValue` (if defined)"
          "	 *"
          "	 * **Note:** Only `object` value types are merged and all other value types are overridden."
          "	 *"
          "	 * Example 1: Overriding"
          "	 *"
          "	 * ```ts"
          "	 * defaultValue = 'on';"
          "	 * globalValue = 'relative'"
          "	 * workspaceFolderValue = 'off'"
          "	 * value = 'off'"
          "	 * ```"
          "	 *"
          "	 * Example 2: Language Values"
          "	 *"
          "	 * ```ts"
          "	 * defaultValue = 'on';"
          "	 * globalValue = 'relative'"
          "	 * workspaceFolderValue = 'off'"
          "	 * globalLanguageValue = 'on'"
          "	 * value = 'on'"
          "	 * ```"
          "	 *"
          "	 * Example 3: Object Values"
          "	 *"
          "	 * ```ts"
          '	 * defaultValue = { "a": 1, "b": 2 };'
          '	 * globalValue = { "b": 3, "c": 4 };'
          '	 * value = { "a": 1, "b": 3, "c": 4 };'
          "	 * ```"
          "	 *"
          "	 * *Note:* Workspace and Workspace Folder configurations contains `launch` and `tasks` settings. Their basename will be"
          "	 * part of the section identifier. The following snippets shows how to retrieve all configurations"
          "	 * from `launch.json`:"
          "	 *"
          "	 * ```ts"
          "	 * // launch.json configuration"
          "	 * const config = workspace.getConfiguration('launch', vscode.workspace.workspaceFolders[0].uri);"
          "	 *"
          "	 * // retrieve values"
          "	 * const values = config.get('configurations');"
          "	 * ```"
          "	 *"
          "	 * Refer to [Settings](https://code.visualstudio.com/docs/getstarted/settings) for more information."
          "	 */"
          "	")
        (interface
          (identifier "WorkspaceConfiguration")
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * Return a value from this configuration."
              "		 *"
              "		 * @param section Configuration name, supports _dotted_ names."
              "		 * @returns The value `section` denotes or `undefined`."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "get")
              (type_parameters
                (parameter_types
                  (parameter_type
                    (type_name
                      (name "T")))))
              (arg_list
                (argument
                  (identifier "section")
                  (types
                    (type
                      (basic_type "string")))))
              (types
                (type
                  (type_name
                    (name "T")))
                (type
                  (type_name
                    (name "undefined")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Return a value from this configuration."
              "		 *"
              "		 * @param section Configuration name, supports _dotted_ names."
              "		 * @param defaultValue A value should be returned when no value could be found, is `undefined`."
              "		 * @returns The value `section` denotes or the default."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "get")
              (type_parameters
                (parameter_types
                  (parameter_type
                    (type_name
                      (name "T")))))
              (arg_list
                (argument
                  (identifier "section")
                  (types
                    (type
                      (basic_type "string"))))
                (argument
                  (identifier "defaultValue")
                  (types
                    (type
                      (type_name
                        (name "T"))))))
              (types
                (type
                  (type_name
                    (name "T")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Check if this configuration has a certain value."
              "		 *"
              "		 * @param section Configuration name, supports _dotted_ names."
              "		 * @returns `true` if the section doesn't resolve to `undefined`."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "has")
              (arg_list
                (argument
                  (identifier "section")
                  (types
                    (type
                      (basic_type "string")))))
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Retrieve all information about a configuration setting. A configuration value"
              "		 * often consists of a *default* value, a global or installation-wide value,"
              "		 * a workspace-specific value, folder-specific value"
              "		 * and language-specific values (if {@link WorkspaceConfiguration} is scoped to a language)."
              "		 *"
              "		 * Also provides all language ids under which the given configuration setting is defined."
              "		 *"
              "		 * *Note:* The configuration name must denote a leaf in the configuration tree"
              "		 * (`editor.fontSize` vs `editor`) otherwise no result is returned."
              "		 *"
              "		 * @param section Configuration name, supports _dotted_ names."
              "		 * @returns Information about a configuration setting or `undefined`."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "inspect")
              (type_parameters
                (parameter_types
                  (parameter_type
                    (type_name
                      (name "T")))))
              (arg_list
                (argument
                  (identifier "section")
                  (types
                    (type
                      (basic_type "string")))))
              (types
                (type
                  (declarations_block
                    (comment__
                      ""
                      ""
                      "			/**"
                      "			 * The fully qualified key of the configuration value"
                      "			 */"
                      "			")
                    (declaration
                      (qualifiers)
                      (identifier "key")
                      (types
                        (type
                          (basic_type "string"))))
                    (comment__
                      ""
                      ""
                      "			/**"
                      "			 * The default value which is used when no other value is defined"
                      "			 */"
                      "			")
                    (declaration
                      (qualifiers)
                      (identifier "defaultValue")
                      (optional "?")
                      (types
                        (type
                          (type_name
                            (name "T")))))
                    (comment__
                      ""
                      ""
                      "			/**"
                      "			 * The global or installation-wide value."
                      "			 */"
                      "			")
                    (declaration
                      (qualifiers)
                      (identifier "globalValue")
                      (optional "?")
                      (types
                        (type
                          (type_name
                            (name "T")))))
                    (comment__
                      ""
                      ""
                      "			/**"
                      "			 * The workspace-specific value."
                      "			 */"
                      "			")
                    (declaration
                      (qualifiers)
                      (identifier "workspaceValue")
                      (optional "?")
                      (types
                        (type
                          (type_name
                            (name "T")))))
                    (comment__
                      ""
                      ""
                      "			/**"
                      "			 * The workspace-folder-specific value."
                      "			 */"
                      "			")
                    (declaration
                      (qualifiers)
                      (identifier "workspaceFolderValue")
                      (optional "?")
                      (types
                        (type
                          (type_name
                            (name "T")))))
                    (comment__
                      ""
                      ""
                      "			/**"
                      "			 * Language specific default value when this configuration value is created for a {@link ConfigurationScope language scope}."
                      "			 */"
                      "			")
                    (declaration
                      (qualifiers)
                      (identifier "defaultLanguageValue")
                      (optional "?")
                      (types
                        (type
                          (type_name
                            (name "T")))))
                    (comment__
                      ""
                      ""
                      "			/**"
                      "			 * Language specific global value when this configuration value is created for a {@link ConfigurationScope language scope}."
                      "			 */"
                      "			")
                    (declaration
                      (qualifiers)
                      (identifier "globalLanguageValue")
                      (optional "?")
                      (types
                        (type
                          (type_name
                            (name "T")))))
                    (comment__
                      ""
                      ""
                      "			/**"
                      "			 * Language specific workspace value when this configuration value is created for a {@link ConfigurationScope language scope}."
                      "			 */"
                      "			")
                    (declaration
                      (qualifiers)
                      (identifier "workspaceLanguageValue")
                      (optional "?")
                      (types
                        (type
                          (type_name
                            (name "T")))))
                    (comment__
                      ""
                      ""
                      "			/**"
                      "			 * Language specific workspace-folder value when this configuration value is created for a {@link ConfigurationScope language scope}."
                      "			 */"
                      "			")
                    (declaration
                      (qualifiers)
                      (identifier "workspaceFolderLanguageValue")
                      (optional "?")
                      (types
                        (type
                          (type_name
                            (name "T")))))
                    (comment__
                      ""
                      ""
                      "			/**"
                      "			 * All language identifiers for which this configuration is defined."
                      "			 */"
                      "			")
                    (declaration
                      (qualifiers)
                      (identifier "languageIds")
                      (optional "?")
                      (types
                        (type
                          (array_of
                            (array_types
                              (array_type
                                (basic_type "string")))))))))
                (type
                  (type_name
                    (name "undefined")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Update a configuration value. The updated configuration values are persisted."
              "		 *"
              "		 * A value can be changed in"
              "		 *"
              "		 * - {@link ConfigurationTarget.Global Global settings}: Changes the value for all instances of the editor."
              "		 * - {@link ConfigurationTarget.Workspace Workspace settings}: Changes the value for current workspace, if available."
              "		 * - {@link ConfigurationTarget.WorkspaceFolder Workspace folder settings}: Changes the value for settings from one of the {@link workspace.workspaceFolders Workspace Folders} under which the requested resource belongs to."
              "		 * - Language settings: Changes the value for the requested languageId."
              "		 *"
              "		 * *Note:* To remove a configuration value use `undefined`, like so: `config.update('somekey', undefined)`"
              "		 *"
              "		 * @param section Configuration name, supports _dotted_ names."
              "		 * @param value The new value."
              "		 * @param configurationTarget The {@link ConfigurationTarget configuration target} or a boolean value."
              "		 *	- If `true` updates {@link ConfigurationTarget.Global Global settings}."
              "		 *	- If `false` updates {@link ConfigurationTarget.Workspace Workspace settings}."
              "		 *	- If `undefined` or `null` updates to {@link ConfigurationTarget.WorkspaceFolder Workspace folder settings} if configuration is resource specific,"
              "		 * 	otherwise to {@link ConfigurationTarget.Workspace Workspace settings}."
              "		 * @param overrideInLanguage Whether to update the value in the scope of requested languageId or not."
              "		 *	- If `true` updates the value under the requested languageId."
              "		 *	- If `undefined` updates the value under the requested languageId only if the configuration is defined for the language."
              "		 * @throws error while updating"
              "		 *	- configuration which is not registered."
              "		 *	- window configuration to workspace folder"
              "		 *	- configuration to workspace or workspace folder when no workspace is opened."
              "		 *	- configuration to workspace folder when there is no workspace folder settings."
              "		 *	- configuration to workspace folder when {@link WorkspaceConfiguration} is not scoped to a resource."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "update")
              (arg_list
                (argument
                  (identifier "section")
                  (types
                    (type
                      (basic_type "string"))))
                (argument
                  (identifier "value")
                  (types
                    (type
                      (basic_type "any"))))
                (argument
                  (identifier "configurationTarget")
                  (optional "?")
                  (types
                    (type
                      (type_name
                        (name "ConfigurationTarget")))
                    (type
                      (basic_type "boolean"))
                    (type
                      (basic_type "null"))))
                (argument
                  (identifier "overrideInLanguage")
                  (optional "?")
                  (types
                    (type
                      (basic_type "boolean")))))
              (types
                (type
                  (generic_type
                    (type_name
                      (name "Thenable"))
                    (type_parameters
                      (parameter_types
                        (parameter_type
                          (basic_type "void"))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Readable dictionary that backs this configuration."
              "		 */"
              "		")
            (map_signature
              (index_signature
                (readonly "readonly")
                (identifier "key")
                (type
                  (basic_type "string")))
              (types
