    (comment__
      ""
      ""
      "/**"
      " * Known error codes for an `InitializeErrorCodes`;"
      " */"
      "")
    (virtual_enum
      (identifier "InitializeErrorCodes")
      (comment__
        ""
        ""
        "	/**"
        "	 * If the protocol version provided by the client can't be handled by"
        "	 * the server."
        "	 *"
        "	 * @deprecated This initialize error got replaced by client capabilities."
        "	 * There is no version handshake in version 3.0x"
        "	 */"
        "	")
      (const
        (declaration
          (qualifiers)
          (identifier "unknownProtocolVersion")
          (types
            (type
              (literal
                (integer "1")))))
        (literal
          (integer "1"))))
    (type_alias
      (identifier "InitializeErrorCodes")
      (types
        (type
          (literal
            (integer "1")))))
    (interface
      (identifier "InitializeError")
      (declarations_block
        (comment__
          ""
          "	/**"
          "	 * Indicates whether the client execute the following retry logic:"
          "	 * (1) show the message provided by the ResponseError to the user"
          "	 * (2) user selects retry or cancel"
          "	 * (3) if user selected retry the initialize method is sent again."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "retry")
          (types
            (type
              (basic_type "boolean"))))))
    (interface
      (identifier "ServerCapabilities")
      (declarations_block
        (comment__
          ""
          ""
          "	/**"
          "	 * The position encoding the server picked from the encodings offered"
          "	 * by the client via the client capability `general.positionEncodings`."
          "	 *"
          "	 * If the client didn't provide any position encodings the only valid"
          "	 * value that a server can return is 'utf-16'."
          "	 *"
          "	 * If omitted it defaults to 'utf-16'."
          "	 *"
          "	 * @since 3.17.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "positionEncoding")
          (optional "?")
          (types
            (type
              (type_name
                (name "PositionEncodingKind")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Defines how text documents are synced. Is either a detailed structure"
          "	 * defining each notification or for backwards compatibility the"
          "	 * TextDocumentSyncKind number. If omitted it defaults to"
          "	 * `TextDocumentSyncKind.None`."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "textDocumentSync")
          (optional "?")
          (types
            (type
              (type_name
                (name "TextDocumentSyncOptions")))
            (type
              (type_name
                (name "TextDocumentSyncKind")))))
