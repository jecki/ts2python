              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "placeholder")
              (types
                (type
                  (basic_type "string"))
                (type
                  (type_name
                    (name "undefined")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Optional text that provides instructions or context to the user."
              "		 *"
              "		 * The prompt is displayed below the input box and above the list of items."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "prompt")
              (types
                (type
                  (basic_type "string"))
                (type
                  (type_name
                    (name "undefined")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * An event signaling when the value of the filter text has changed."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "onDidChangeValue")
              (types
                (type
                  (generic_type
                    (type_name
                      (name "Event"))
                    (type_parameters
                      (parameter_types
                        (parameter_type
                          (basic_type "string"))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * An event signaling when the user indicated acceptance of the selected item(s)."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "onDidAccept")
              (types
                (type
                  (generic_type
                    (type_name
                      (name "Event"))
                    (type_parameters
                      (parameter_types
                        (parameter_type
                          (basic_type "void"))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Buttons for actions in the UI."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "buttons")
              (types
                (type
                  (readonly "readonly")
                  (array_of
                    (array_types
                      (array_type
                        (type_name
                          (name "QuickInputButton"))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * An event signaling when a button was triggered."
              "		 *"
              "		 * This event fires for buttons stored in the {@link QuickPick.buttons buttons} array. This event does"
              "		 * not fire for buttons on a {@link QuickPickItem}."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "onDidTriggerButton")
              (types
                (type
                  (generic_type
                    (type_name
                      (name "Event"))
                    (type_parameters
                      (parameter_types
                        (parameter_type
                          (type_name
                            (name "QuickInputButton")))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * An event signaling when a button in a particular {@link QuickPickItem} was triggered."
              "		 *"
              "		 * This event does not fire for buttons in the title bar which are part of {@link QuickPick.buttons buttons}."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "onDidTriggerItemButton")
              (types
