        (comment__
          ""
          ""
          "	/**"
          "	 * Value-object describing what options a terminal should use."
          "	 */"
          "	")
        (interface
          (identifier "TerminalOptions")
          (declarations_block
            (comment__
              ""
              "		/**"
              "		 * A human-readable string which will be used to represent the terminal in the UI."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "name")
              (optional "?")
              (types
                (type
                  (basic_type "string"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * A path to a custom shell executable to be used in the terminal."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "shellPath")
              (optional "?")
              (types
                (type
                  (basic_type "string"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Args for the custom shell executable. A string can be used on Windows only which allows"
              "		 * specifying shell args in [command-line format](https://msdn.microsoft.com/en-au/08dfcab2-eb6e-49a4-80eb-87d4076c98c6)."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "shellArgs")
              (optional "?")
              (types
                (type
                  (array_of
                    (array_types
                      (array_type
                        (basic_type "string")))))
                (type
                  (basic_type "string"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * A path or Uri for the current working directory to be used for the terminal."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "cwd")
              (optional "?")
              (types
                (type
                  (basic_type "string"))
                (type
                  (type_name
                    (name "Uri")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Object with environment variables that will be added to the editor process."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "env")
              (optional "?")
              (types
                (type
                  (mapped_type
                    (map_signature
                      (index_signature
                        (identifier "key")
                        (type
                          (basic_type "string")))
                      (types
                        (type
                          (basic_type "string"))
                        (type
                          (basic_type "null"))
                        (type
                          (type_name
                            (name "undefined")))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Whether the terminal process environment should be exactly as provided in"
              "		 * `TerminalOptions.env`. When this is false (default), the environment will be based on the"
              "		 * window's environment and also apply configured platform settings like"
              "		 * `terminal.integrated.env.windows` on top. When this is true, the complete environment"
              "		 * must be provided as nothing will be inherited from the process or any configuration."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "strictEnv")
              (optional "?")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * When enabled the terminal will run the process as normal but not be surfaced to the user"
              "		 * until `Terminal.show` is called. The typical usage for this is when you need to run"
              "		 * something that may need interactivity but only want to tell the user about it when"
              "		 * interaction is needed. Note that the terminals will still be exposed to all extensions"
              "		 * as normal. The hidden terminals will not be restored when the workspace is next opened."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "hideFromUser")
              (optional "?")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * A message to write to the terminal on first launch, note that this is not sent to the"
              "		 * process but, rather written directly to the terminal. This supports escape sequences such"
              "		 * a setting text style."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "message")
              (optional "?")
              (types
                (type
                  (basic_type "string"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The icon path or {@link ThemeIcon} for the terminal."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "iconPath")
              (optional "?")
              (types
