                      (name "ProviderResult"))
                    (type_parameters
                      (parameter_types
                        (parameter_type
                          (array_of
                            (array_types
                              (array_type
                                (type_name
                                  (name "CallHierarchyOutgoingCall"))))))))))))))
        (comment__
