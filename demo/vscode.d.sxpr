                  (type_name
                    (name "IconPath")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The icon {@link ThemeColor} for the terminal."
              "		 * The `terminal.ansi*` theme keys are"
              "		 * recommended for the best contrast and consistency across themes."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "color")
              (optional "?")
              (types
