              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "description")
              (types
                (type
                  (basic_type "string"))
                (type
                  (type_name
                    (name "MarkdownString")))
                (type
                  (type_name
                    (name "undefined")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Replace an environment variable with a value."
              "		 *"
