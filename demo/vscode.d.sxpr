        (comment__
          ""
          ""
          "	/**"
          "	 * A line based folding range. To be valid, start and end line must be bigger than zero and smaller than the number of lines in the document."
          "	 * Invalid ranges will be ignored."
          "	 */"
          "	")
        (interface
          (identifier "FoldingRange")
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * The zero-based start line of the range to fold. The folded area starts after the line's last character."
              "		 * To be valid, the end must be zero or larger and smaller than the number of lines in the document."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "start")
              (types
                (type
                  (basic_type "number"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The zero-based end line of the range to fold. The folded area ends with the line's last character."
              "		 * To be valid, the end must be zero or larger and smaller than the number of lines in the document."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "end")
              (types
                (type
                  (basic_type "number"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Describes the {@link FoldingRangeKind Kind} of the folding range such as {@link FoldingRangeKind.Comment Comment} or"
              "		 * {@link FoldingRangeKind.Region Region}. The kind is used to categorize folding ranges and used by commands"
              "		 * like 'Fold all comments'. See"
              "		 * {@link FoldingRangeKind} for an enumeration of all kinds."
              "		 * If not set, the range is originated from a syntax element."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "kind")
              (optional "?")
              (types
                (type
                  (type_name
                    (name "FoldingRangeKind")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Creates a new folding range."
              "		 *"
              "		 * @param start The start line of the folded range."
              "		 * @param end The end line of the folded range."
              "		 * @param kind The kind of the folding range."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "constructor")
              (arg_list
                (argument
                  (identifier "start")
                  (types
                    (type
                      (basic_type "number"))))
                (argument
                  (identifier "end")
                  (types
                    (type
                      (basic_type "number"))))
                (argument
                  (identifier "kind")
                  (optional "?")
                  (types
                    (type
                      (type_name
                        (name "FoldingRangeKind")))))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * An enumeration of specific folding range kinds. The kind is an optional field of a {@link FoldingRange}"
          "	 * and is used to distinguish specific folding ranges such as ranges originated from comments. The kind is used by commands like"
          "	 * `Fold all comments` or `Fold all regions`."
          "	 * If the kind is not set on the range, the range originated from a syntax element other than comments, imports or region markers."
          "	 */"
          "	")
        (enum
          (identifier "FoldingRangeKind")
          (comment__
            ""
            "		/**"
            "		 * Kind for folding range representing a comment."
            "		 */"
            "		")
          (item
            (identifier "Comment")
            (literal
              (integer "1")))
          (comment__
            ""
            "		/**"
            "		 * Kind for folding range representing a import."
            "		 */"
            "		")
          (item
            (identifier "Imports")
            (literal
              (integer "2")))
          (comment__
            ""
            "		/**"
            "		 * Kind for folding range representing regions originating from folding markers like `#region` and `#endregion`."
            "		 */"
            "		")
          (item
            (identifier "Region")
            (literal
              (integer "3"))))
        (comment__
