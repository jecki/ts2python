                  (basic_type "any"))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Represents a location inside a resource, such as a line"
          "	 * inside a text file."
          "	 */"
          "	")
        (interface
          (identifier "Location")
          (declarations_block
            (comment__
              ""
              ""
