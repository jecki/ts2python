                        (type_name
                          (name "NotebookDocumentCellChange"))))))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * An event that is fired when a {@link NotebookDocument notebook document} will be saved."
          "	 *"
          "	 * To make modifications to the document before it is being saved, call the"
          "	 * {@linkcode NotebookDocumentWillSaveEvent.waitUntil waitUntil}-function with a thenable"
          "	 * that resolves to a {@link WorkspaceEdit workspace edit}."
          "	 */"
          "	")
        (interface
          (identifier "NotebookDocumentWillSaveEvent")
          (declarations_block
            (comment__
              ""
              "		/**"
              "		 * A cancellation token."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "token")
              (types
                (type
                  (type_name
                    (name "CancellationToken")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The {@link NotebookDocument notebook document} that will be saved."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "notebook")
              (types
                (type
                  (type_name
                    (name "NotebookDocument")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The reason why save was triggered."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "reason")
              (types
                (type
                  (type_name
                    (name "TextDocumentSaveReason")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Allows to pause the event loop and to apply {@link WorkspaceEdit workspace edit}."
              "		 * Edits of subsequent calls to this function will be applied in order. The"
              "		 * edits will be *ignored* if concurrent modifications of the notebook document happened."
              "		 *"
              "		 * *Note:* This function can only be called during event dispatch and not"
              "		 * in an asynchronous manner:"
              "		 *"
              "		 * ```ts"
              "		 * workspace.onWillSaveNotebookDocument(event => {"
              "		 * 	// async, will *throw* an error"
              "		 * 	setTimeout(() => event.waitUntil(promise));"
              "		 *"
              "		 * 	// sync, OK"
              "		 * 	event.waitUntil(promise);"
              "		 * })"
              "		 * ```"
              "		 *"
              "		 * @param thenable A thenable that resolves to {@link WorkspaceEdit workspace edit}."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "waitUntil")
              (arg_list
                (argument
                  (identifier "thenable")
                  (types
                    (type
                      (generic_type
                        (type_name
                          (name "Thenable"))
                        (type_parameters
                          (parameter_types
                            (parameter_type
                              (type_name
                                (name "WorkspaceEdit"))))))))))
              (types
                (type
                  (basic_type "void"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Allows to pause the event loop until the provided thenable resolved."
              "		 *"
              "		 * *Note:* This function can only be called during event dispatch."
              "		 *"
              "		 * @param thenable A thenable that delays saving."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "waitUntil")
              (arg_list
                (argument
                  (identifier "thenable")
                  (types
                    (type
                      (generic_type
                        (type_name
                          (name "Thenable"))
                        (type_parameters
                          (parameter_types
                            (parameter_type
                              (basic_type "any")))))))))
              (types
                (type
                  (basic_type "void"))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * The summary of a notebook cell execution."
          "	 */"
          "	")
        (interface
          (identifier "NotebookCellExecutionSummary")
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * The order in which the execution happened."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "executionOrder")
              (optional "?")
              (types
                (type
                  (basic_type "number"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * If the execution finished successfully."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "success")
              (optional "?")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The times at which execution started and ended, as unix timestamps"
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "timing")
              (optional "?")
              (types
                (type
                  (declarations_block
                    (comment__
                      ""
                      "			/**"
                      "			 * Execution start time."
                      "			 */"
                      "			")
                    (declaration
                      (qualifiers
                        (readonly "readonly"))
                      (identifier "startTime")
                      (types
                        (type
                          (basic_type "number"))))
                    (comment__
                      ""
                      "			/**"
                      "			 * Execution end time."
                      "			 */"
                      "			")
                    (declaration
                      (qualifiers
                        (readonly "readonly"))
                      (identifier "endTime")
                      (types
                        (type
                          (basic_type "number"))))))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * A notebook range represents an ordered pair of two cell indices."
          "	 * It is guaranteed that start is less than or equal to end."
          "	 */"
          "	")
        (interface
          (identifier "NotebookRange")
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * The zero-based start index of this range."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "start")
              (types
                (type
                  (basic_type "number"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The exclusive end index of this range (zero-based)."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "end")
              (types
                (type
                  (basic_type "number"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * `true` if `start` and `end` are equal."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "isEmpty")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Create a new notebook range. If `start` is not"
              "		 * before or equal to `end`, the values will be swapped."
