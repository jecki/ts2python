        (comment__
          ""
          ""
          "	/**"
          "	 * The implementation provider interface defines the contract between extensions and"
          "	 * the go to implementation feature."
          "	 */"
          "	")
        (interface
          (identifier "ImplementationProvider")
          (declarations_block
            (comment__
              ""
