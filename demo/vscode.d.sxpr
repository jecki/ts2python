        (comment__
          ""
          ""
          "	/**"
          "	 * The type hierarchy provider interface describes the contract between extensions"
          "	 * and the type hierarchy feature."
          "	 */"
          "	")
        (interface
          (identifier "TypeHierarchyProvider")
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * Bootstraps type hierarchy by returning the item that is denoted by the given document"
              "		 * and position. This item will be used as entry into the type graph. Providers should"
              "		 * return `undefined` or `null` when there is no item at the given location."
              "		 *"
              "		 * @param document The document in which the command was invoked."
              "		 * @param position The position at which the command was invoked."
              "		 * @param token A cancellation token."
              "		 * @returns One or multiple type hierarchy items or a thenable that resolves to such. The lack of a result can be"
              "		 * signaled by returning `undefined`, `null`, or an empty array."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "prepareTypeHierarchy")
              (arg_list
                (argument
                  (identifier "document")
                  (types
                    (type
                      (type_name
                        (name "TextDocument")))))
                (argument
                  (identifier "position")
                  (types
                    (type
                      (type_name
                        (name "Position")))))
                (argument
                  (identifier "token")
                  (types
                    (type
                      (type_name
                        (name "CancellationToken"))))))
              (types
                (type
                  (generic_type
                    (type_name
                      (name "ProviderResult"))
                    (type_parameters
                      (parameter_types
                        (parameter_type
                          (type_name
                            (name "TypeHierarchyItem")))
                        (parameter_type
                          (array_of
                            (array_types
                              (array_type
                                (type_name
                                  (name "TypeHierarchyItem"))))))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Provide all supertypes for an item, e.g all types from which a type is derived/inherited. In graph terms this describes directed"
              "		 * and annotated edges inside the type graph, e.g the given item is the starting node and the result is the nodes"
              "		 * that can be reached."
              "		 *"
              "		 * @param item The hierarchy item for which super types should be computed."
              "		 * @param token A cancellation token."
              "		 * @returns A set of direct supertypes or a thenable that resolves to such. The lack of a result can be"
              "		 * signaled by returning `undefined` or `null`."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "provideTypeHierarchySupertypes")
              (arg_list
                (argument
                  (identifier "item")
                  (types
                    (type
                      (type_name
                        (name "TypeHierarchyItem")))))
                (argument
                  (identifier "token")
                  (types
                    (type
                      (type_name
                        (name "CancellationToken"))))))
              (types
                (type
                  (generic_type
                    (type_name
                      (name "ProviderResult"))
                    (type_parameters
