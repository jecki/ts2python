        (comment__
          ""
          ""
          "	/**"
          "	 * A human-readable string with additional information"
          "	 * about this item, like type or symbol information."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "detail")
          (optional "?")
          (types
            (type
              (basic_type "string"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * A human-readable string that represents a doc-comment."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "documentation")
          (optional "?")
          (types
            (type
              (basic_type "string"))
            (type
              (type_name
                (name "MarkupContent")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Indicates if this item is deprecated."
          "	 *"
          "	 * @deprecated Use `tags` instead if supported."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "deprecated")
          (optional "?")
          (types
            (type
              (basic_type "boolean"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Select this item when showing."
          "	 *"
          "	 * *Note* that only one completion item can be selected and that the"
          "	 * tool / client decides which item that is. The rule is that the *first*"
          "	 * item of those that match best is selected."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "preselect")
          (optional "?")
          (types
            (type
              (basic_type "boolean"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * A string that should be used when comparing this item"
          "	 * with other items. When omitted, the label is used"
          "	 * as the sort text for this item."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "sortText")
          (optional "?")
          (types
            (type
              (basic_type "string"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * A string that should be used when filtering a set of"
          "	 * completion items. When omitted, the label is used as the"
          "	 * filter text for this item."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "filterText")
          (optional "?")
          (types
            (type
              (basic_type "string"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * A string that should be inserted into a document when selecting"
          "	 * this completion. When omitted, the label is used as the insert text"
          "	 * for this item."
          "	 *"
          "	 * The `insertText` is subject to interpretation by the client side."
          "	 * Some tools might not take the string literally. For example,"
          "	 * when code complete is requested for `con<cursor position>`"
          "	 * and a completion item with an `insertText` of `console` is provided,"
          "	 * VSCode will only insert `sole`. Therefore, it is"
          "	 * recommended to use `textEdit` instead since it avoids additional client"
          "	 * side interpretation."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "insertText")
          (optional "?")
          (types
            (type
              (basic_type "string"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * The format of the insert text. The format applies to both the"
          "	 * `insertText` property and the `newText` property of a provided"
          "	 * `textEdit`. If omitted, defaults to `InsertTextFormat.PlainText`."
          "	 *"
          "	 * Please note that the insertTextFormat doesn't apply to"
          "	 * `additionalTextEdits`."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "insertTextFormat")
          (optional "?")
          (types
            (type
              (type_name
                (name "InsertTextFormat")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * How whitespace and indentation is handled during completion"
          "	 * item insertion. If not provided, the client's default value depends on"
          "	 * the `textDocument.completion.insertTextMode` client capability."
          "	 *"
          "	 * @since 3.16.0"
          "	 * @since 3.17.0 - support for `textDocument.completion.insertTextMode`"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "insertTextMode")
          (optional "?")
          (types
            (type
              (type_name
                (name "InsertTextMode")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * An edit which is applied to a document when selecting this completion."
          "	 * When an edit is provided, the value of `insertText` is ignored."
          "	 *"
          "	 * *Note:* The range of the edit must be a single line range and it must"
          "	 * contain the position at which completion has been requested. Despite this"
          "	 * limitation, your edit can write multiple lines."
          "	 *"
          "	 * Most editors support two different operations when accepting a completion"
          "	 * item. One is to insert a completion text and the other is to replace an"
          "	 * existing text with a completion text. Since this can usually not be"
          "	 * predetermined by a server it can report both ranges. Clients need to"
          "	 * signal support for `InsertReplaceEdit`s via the"
          "	 * `textDocument.completion.completionItem.insertReplaceSupport` client"
          "	 * capability property."
          "	 *"
          "	 * *Note 1:* The text edit's range as well as both ranges from an insert"
          "	 * replace edit must be a single line and they must contain the position"
          "	 * at which completion has been requested. In both cases, the new text can"
          "	 * consist of multiple lines."
          "	 * *Note 2:* If an `InsertReplaceEdit` is returned, the edit's insert range"
          "	 * must be a prefix of the edit's replace range, meaning it must be"
          "	 * contained in and starting at the same position."
          "	 *"
          "	 * @since 3.16.0 additional type `InsertReplaceEdit`"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "textEdit")
          (optional "?")
          (types
            (type
              (type_name
                (name "TextEdit")))
            (type
              (type_name
                (name "InsertReplaceEdit")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * The edit text used if the completion item is part of a CompletionList and"
          "	 * CompletionList defines an item default for the text edit range."
          "	 *"
          "	 * Clients will only honor this property if they opt into completion list"
          "	 * item defaults using the capability `completionList.itemDefaults`."
          "	 *"
          "	 * If not provided and a list's default range is provided, the label"
          "	 * property is used as a text."
          "	 *"
          "	 * @since 3.17.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "textEditText")
          (optional "?")
          (types
            (type
              (basic_type "string"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * An optional array of additional text edits that are applied when"
          "	 * selecting this completion. Edits must not overlap (including the same"
          "	 * insert position) with the main edit nor with themselves."
          "	 *"
          "	 * Additional text edits should be used to change text unrelated to the"
          "	 * current cursor position (for example adding an import statement at the"
          "	 * top of the file if the completion item will insert an unqualified type)."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "additionalTextEdits")
          (optional "?")
          (types
            (type
              (array_of
                (array_types
                  (array_type
                    (type_name
                      (name "TextEdit"))))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * An optional set of characters that, when pressed while this completion is"
          "	 * active, will accept it first and then type that character. *Note* that all"
          "	 * commit characters should have `length=1` and that superfluous characters"
          "	 * will be ignored."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "commitCharacters")
          (optional "?")
          (types
            (type
              (array_of
                (array_types
                  (array_type
                    (basic_type "string")))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * An optional command that is executed *after* inserting this completion."
          "	 * *Note* that additional modifications to the current document should be"
          "	 * described with the additionalTextEdits-property."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "command")
          (optional "?")
          (types
            (type
              (type_name
                (name "Command")))))
        (comment__
