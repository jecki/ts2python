              "		/**"
              "		 * The type of the file, e.g. is a regular file, a directory, or symbolic link"
              "		 * to a file."
              "		 *"
              "		 * *Note:* This value might be a bitmask, e.g. `FileType.File | FileType.SymbolicLink`."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "type")
