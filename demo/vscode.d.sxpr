                      "			/**"
                      "			 * A tooltip for the checkbox"
                      "			 */"
                      "			")
                    (declaration
                      (qualifiers
                        (readonly "readonly"))
                      (identifier "tooltip")
                      (optional "?")
                      (types
                        (type
                          (basic_type "string"))))
                    (comment__
                      ""
                      "			/**"
                      "			 * Accessibility information used when screen readers interact with this checkbox"
                      "			 */"
                      "			")
                    (declaration
                      (qualifiers
                        (readonly "readonly"))
                      (identifier "accessibilityInformation")
                      (optional "?")
                      (types
                        (type
                          (type_name
                            (name "AccessibilityInformation")))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * @param label A human-readable string describing this item"
              "		 * @param collapsibleState {@link TreeItemCollapsibleState} of the tree item. Default is {@link TreeItemCollapsibleState.None}"
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "constructor")
              (arg_list
                (argument
                  (identifier "label")
                  (types
                    (type
                      (basic_type "string"))
                    (type
                      (type_name
                        (name "TreeItemLabel")))))
                (argument
