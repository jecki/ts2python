              "		/**"
              "		 * Push a progress part to this stream. Short-hand for"
              "		 * `push(new ChatResponseProgressPart(value))`."
              "		 *"
              "		 * @param value A progress message"
              "		 */"
              "		")
            (function
              (qualifiers)
