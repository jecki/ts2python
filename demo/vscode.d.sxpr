                          "			/**"
                          "			 * Overwrite the file if it does exist."
                          "			 */"
                          "			")
                        (declaration
                          (qualifiers
                            (readonly "readonly"))
                          (identifier "overwrite")
                          (types
                            (type
                              (basic_type "boolean")))))))))
              (types
