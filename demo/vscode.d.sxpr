              "		 * Push a filetree part to this stream. Short-hand for"
              "		 * `push(new ChatResponseFileTreePart(value))`."
              "		 *"
              "		 * @param value File tree data."
              "		 * @param baseUri The base uri to which this file tree is relative."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "filetree")
              (arg_list
                (argument
                  (identifier "value")
