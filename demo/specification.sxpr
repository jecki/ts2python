    (comment__
      ""
      ""
      "/**"
      " * General client capabilities."
      " *"
      " * @since 3.16.0"
      " */"
      "")
    (interface
      (identifier "GeneralClientCapabilities")
      (declarations_block
        (comment__
          ""
          "	/**"
          "	 * Client capability that signals how the client"
          "	 * handles stale requests (e.g. a request"
          "	 * for which the client will not process the response"
          "	 * anymore since the information is outdated)."
          "	 *"
          "	 * @since 3.17.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "staleRequestSupport")
          (optional "?")
          (types
            (type
              (type_name
                (name "StaleRequestSupportOptions")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Client capabilities specific to regular expressions."
          "	 *"
          "	 * @since 3.16.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "regularExpressions")
          (optional "?")
          (types
            (type
              (type_name
                (name "RegularExpressionsClientCapabilities")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Client capabilities specific to the client's markdown parser."
          "	 *"
          "	 * @since 3.16.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "markdown")
          (optional "?")
          (types
            (type
              (type_name
                (name "MarkdownClientCapabilities")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * The position encodings supported by the client. Client and server"
          "	 * have to agree on the same position encoding to ensure that offsets"
          "	 * (e.g. character position in a line) are interpreted the same on both"
          "	 * sides."
          "	 *"
          "	 * To keep the protocol backwards compatible the following applies: if"
          "	 * the value 'utf-16' is missing from the array of position encodings"
          "	 * servers can assume that the client supports UTF-16. UTF-16 is"
          "	 * therefore a mandatory encoding."
          "	 *"
          "	 * If omitted it defaults to ['utf-16']."
          "	 *"
          "	 * Implementation considerations: since the conversion from one encoding"
          "	 * into another requires the content of the file / line the conversion"
          "	 * is best done where the file is read which is usually on the server"
          "	 * side."
          "	 *"
          "	 * @since 3.17.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "positionEncodings")
          (optional "?")
          (types
            (type
              (array_of
                (array_types
                  (array_type
                    (type_name
                      (name "PositionEncodingKind"))))))))))
    (type_alias
