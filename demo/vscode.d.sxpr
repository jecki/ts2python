                        (parameter_type
                          (type_name
                            (name "undefined")))
                        (parameter_type
                          (basic_type "null"))
                        (parameter_type
                          (basic_type "void"))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Get {@link TreeItem} representation of the `element`"
              "		 *"
              "		 * @param element The element for which {@link TreeItem} representation is asked for."
              "		 * @returns TreeItem representation of the element."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "getTreeItem")
              (arg_list
                (argument
                  (identifier "element")
