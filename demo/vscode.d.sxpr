              (qualifiers)
              (identifier "range")
              (types
                (type
                  (type_name
                    (name "Range")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The command this code lens represents."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "command")
              (optional "?")
              (types
