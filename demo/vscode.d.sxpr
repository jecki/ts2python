        (comment__
          ""
          ""
          "	/**"
          "	 * Message associated with the test state. Can be linked to a specific"
          "	 * source range -- useful for assertion failures, for example."
          "	 */"
          "	")
        (interface
          (identifier "TestMessage")
          (declarations_block
            (comment__
              ""
              "		/**"
              "		 * Human-readable message text to display."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "message")
              (types
                (type
                  (basic_type "string"))
                (type
                  (type_name
                    (name "MarkdownString")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Expected test output. If given with {@link TestMessage.actualOutput actualOutput }, a diff view will be shown."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "expectedOutput")
              (optional "?")
              (types
                (type
                  (basic_type "string"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Actual test output. If given with {@link TestMessage.expectedOutput expectedOutput }, a diff view will be shown."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "actualOutput")
              (optional "?")
              (types
                (type
                  (basic_type "string"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Associated file location."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "location")
              (optional "?")
              (types
                (type
                  (type_name
                    (name "Location")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Context value of the test item. This can be used to contribute message-"
              "		 * specific actions to the test peek view. The value set here can be found"
              "		 * in the `testMessage` property of the following `menus` contribution points:"
              "		 *"
              "		 * - `testing/message/context` - context menu for the message in the results tree"
              "		 * - `testing/message/content` - a prominent button overlaying editor content where"
              "		 *    the message is displayed."
              "		 *"
              "		 * For example:"
              "		 *"
              "		 * ```json"
              '		 * "contributes": {'
              '		 *   "menus": {'
              '		 *     "testing/message/content": ['
              "		 *       {"
              '		 *         "command": "extension.deleteCommentThread",'
              '		 *         "when": "testMessage == canApplyRichDiff"'
              "		 *       }"
              "		 *     ]"
              "		 *   }"
              "		 * }"
              "		 * ```"
              "		 *"
              "		 * The command will be called with an object containing:"
              "		 * - `test`: the {@link TestItem} the message is associated with, *if* it"
              "		 *    is still present in the {@link TestController.items} collection."
              "		 * - `message`: the {@link TestMessage} instance."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "contextValue")
              (optional "?")
              (types
                (type
                  (basic_type "string"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The stack trace associated with the message or failure."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "stackTrace")
              (optional "?")
              (types
                (type
                  (array_of
                    (array_types
                      (array_type
                        (type_name
                          (name "TestMessageStackFrame"))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Creates a new TestMessage that will present as a diff in the editor."
              "		 * @param message Message to display to the user."
              "		 * @param expected Expected output."
              "		 * @param actual Actual output."
              "		 */"
              "		")
            (function
              (qualifiers
                (static "static"))
              (identifier "diff")
              (arg_list
                (argument
                  (identifier "message")
                  (types
                    (type
                      (basic_type "string"))
                    (type
                      (type_name
                        (name "MarkdownString")))))
                (argument
                  (identifier "expected")
                  (types
                    (type
                      (basic_type "string"))))
                (argument
                  (identifier "actual")
                  (types
                    (type
                      (basic_type "string")))))
              (types
                (type
                  (type_name
                    (name "TestMessage")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Creates a new TestMessage instance."
              "		 * @param message The message to show to the user."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "constructor")
              (arg_list
                (argument
                  (identifier "message")
                  (types
                    (type
                      (basic_type "string"))
                    (type
                      (type_name
                        (name "MarkdownString")))))))))
        (comment__
          ""
          ""
