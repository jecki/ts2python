              "		 * The resource identifier of this location."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "uri")
              (types
                (type
                  (type_name
                    (name "Uri")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The document range of this location."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "range")
              (types
                (type
                  (type_name
                    (name "Range")))))
            (comment__
