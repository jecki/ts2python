        (comment__
          ""
          ""
          "	/**"
          "	 * Value-object describing what options formatting should use."
          "	 */"
          "	")
        (interface
          (identifier "FormattingOptions")
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * Size of a tab in spaces."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "tabSize")
              (types
                (type
