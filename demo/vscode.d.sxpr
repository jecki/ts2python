          "	")
        (interface
          (identifier "OnEnterRule")
          (declarations_block
            (comment__
              ""
              "		/**"
              "		 * This rule will only execute if the text before the cursor matches this regular expression."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "beforeText")
              (types
