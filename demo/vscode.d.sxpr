                        (type_name
                          (name "NotebookCellOutput"))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Arbitrary metadata of this cell data. Can be anything but must be JSON-stringifyable."
              "		 */"
              "		")
            (declaration
              (qualifiers)
