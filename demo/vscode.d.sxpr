        (comment__
          ""
          ""
          "	/**"
          "	 * The completion item provider interface defines the contract between extensions and"
          "	 * [IntelliSense](https://code.visualstudio.com/docs/editor/intellisense)."
          "	 *"
          "	 * Providers can delay the computation of the {@linkcode CompletionItem.detail detail}"
          "	 * and {@linkcode CompletionItem.documentation documentation} properties by implementing the"
          "	 * {@linkcode CompletionItemProvider.resolveCompletionItem resolveCompletionItem}-function. However, properties that"
          "	 * are needed for the initial sorting and filtering, like `sortText`, `filterText`, `insertText`, and `range`, must"
          "	 * not be changed during resolve."
          "	 *"
          "	 * Providers are asked for completions either explicitly by a user gesture or -depending on the configuration-"
          "	 * implicitly when typing words or trigger characters."
          "	 */"
          "	")
        (interface
          (identifier "CompletionItemProvider")
          (type_parameters
            (parameter_types
              (parameter_type
                (type_name
                  (name "T"))
                (extends_type
                  (type_name
                    (name "CompletionItem")))
                (equals_type
                  (type_name
                    (name "CompletionItem"))))))
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * Provide completion items for the given position and document."
              "		 *"
              "		 * @param document The document in which the command was invoked."
              "		 * @param position The position at which the command was invoked."
              "		 * @param token A cancellation token."
              "		 * @param context How the completion was triggered."
              "		 *"
              "		 * @returns An array of completions, a {@link CompletionList completion list}, or a thenable that resolves to either."
              "		 * The lack of a result can be signaled by returning `undefined`, `null`, or an empty array."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "provideCompletionItems")
              (arg_list
                (argument
                  (identifier "document")
                  (types
                    (type
                      (type_name
                        (name "TextDocument")))))
                (argument
                  (identifier "position")
                  (types
                    (type
                      (type_name
                        (name "Position")))))
                (argument
                  (identifier "token")
                  (types
                    (type
                      (type_name
                        (name "CancellationToken")))))
                (argument
                  (identifier "context")
                  (types
                    (type
                      (type_name
                        (name "CompletionContext"))))))
              (types
                (type
                  (generic_type
                    (type_name
                      (name "ProviderResult"))
                    (type_parameters
                      (parameter_types
                        (parameter_type
                          (array_of
                            (array_types
                              (array_type
                                (type_name
                                  (name "T"))))))
                        (parameter_type
                          (generic_type
                            (type_name
                              (name "CompletionList"))
                            (type_parameters
                              (parameter_types
                                (parameter_type
                                  (type_name
                                    (name "T")))))))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Given a completion item fill in more data, like {@link CompletionItem.documentation doc-comment}"
              "		 * or {@link CompletionItem.detail details}."
              "		 *"
              "		 * The editor will only resolve a completion item once."
              "		 *"
              "		 * *Note* that this function is called when completion items are already showing in the UI or when an item has been"
              "		 * selected for insertion. Because of that, no property that changes the presentation (label, sorting, filtering etc)"
              "		 * or the (primary) insert behaviour ({@link CompletionItem.insertText insertText}) can be changed."
              "		 *"
              "		 * This function may fill in {@link CompletionItem.additionalTextEdits additionalTextEdits}. However, that means an item might be"
              "		 * inserted *before* resolving is done and in that case the editor will do a best effort to still apply those additional"
              "		 * text edits."
              "		 *"
              "		 * @param item A completion item currently active in the UI."
              "		 * @param token A cancellation token."
              "		 * @returns The resolved completion item or a thenable that resolves to of such. It is OK to return the given"
              "		 * `item`. When no result is returned, the given `item` will be used."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "resolveCompletionItem")
              (optional "?")
              (arg_list
                (argument
                  (identifier "item")
                  (types
                    (type
                      (type_name
                        (name "T")))))
                (argument
                  (identifier "token")
                  (types
                    (type
                      (type_name
                        (name "CancellationToken"))))))
              (types
                (type
                  (generic_type
                    (type_name
                      (name "ProviderResult"))
                    (type_parameters
                      (parameter_types
                        (parameter_type
                          (type_name
                            (name "T")))))))))))
        (comment__
          ""
          ""
          ""
          "	/**"
          "	 * The inline completion item provider interface defines the contract between extensions and"
          "	 * the inline completion feature."
          "	 *"
          "	 * Providers are asked for completions either explicitly by a user gesture or implicitly when typing."
          "	 */"
          "	")
        (interface
          (identifier "InlineCompletionItemProvider")
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * Provides inline completion items for the given position and document."
              "		 * If inline completions are enabled, this method will be called whenever the user stopped typing."
              "		 * It will also be called when the user explicitly triggers inline completions or explicitly asks for the next or previous inline completion."
              "		 * In that case, all available inline completions should be returned."
              "		 * `context.triggerKind` can be used to distinguish between these scenarios."
              "		 *"
              "		 * @param document The document inline completions are requested for."
              "		 * @param position The position inline completions are requested for."
              "		 * @param context A context object with additional information."
              "		 * @param token A cancellation token."
              "		 * @returns An array of completion items or a thenable that resolves to an array of completion items."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "provideInlineCompletionItems")
              (arg_list
                (argument
                  (identifier "document")
                  (types
                    (type
                      (type_name
                        (name "TextDocument")))))
                (argument
                  (identifier "position")
                  (types
                    (type
                      (type_name
                        (name "Position")))))
                (argument
                  (identifier "context")
                  (types
                    (type
                      (type_name
                        (name "InlineCompletionContext")))))
                (argument
                  (identifier "token")
                  (types
                    (type
                      (type_name
                        (name "CancellationToken"))))))
              (types
                (type
                  (generic_type
                    (type_name
                      (name "ProviderResult"))
                    (type_parameters
                      (parameter_types
                        (parameter_type
                          (array_of
                            (array_types
                              (array_type
                                (type_name
                                  (name "InlineCompletionItem"))))))
                        (parameter_type
                          (type_name
                            (name "InlineCompletionList")))))))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Represents a collection of {@link InlineCompletionItem inline completion items} to be presented"
          "	 * in the editor."
          "	 */"
          "	")
        (interface
          (identifier "InlineCompletionList")
          (declarations_block
            (comment__
              ""
              "		/**"
              "		 * The inline completion items."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "items")
              (types
                (type
                  (array_of
                    (array_types
                      (array_type
                        (type_name
                          (name "InlineCompletionItem"))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Creates a new list of inline completion items."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "constructor")
              (arg_list
                (argument
                  (identifier "items")
                  (types
                    (type
                      (array_of
                        (array_types
                          (array_type
                            (type_name
                              (name "InlineCompletionItem"))))))))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Provides information about the context in which an inline completion was requested."
          "	 */"
          "	")
        (interface
          (identifier "InlineCompletionContext")
          (declarations_block
            (comment__
              ""
              "		/**"
              "		 * Describes how the inline completion was triggered."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "triggerKind")
              (types
                (type
                  (type_name
                    (name "InlineCompletionTriggerKind")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Provides information about the currently selected item in the autocomplete widget if it is visible."
              "		 *"
              "		 * If set, provided inline completions must extend the text of the selected item"
              "		 * and use the same range, otherwise they are not shown as preview."
              "		 * As an example, if the document text is `console.` and the selected item is `.log` replacing the `.` in the document,"
              "		 * the inline completion must also replace `.` and start with `.log`, for example `.log()`."
              "		 *"
              "		 * Inline completion providers are requested again whenever the selected item changes."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "selectedCompletionInfo")
              (types
                (type
                  (type_name
                    (name "SelectedCompletionInfo")))
                (type
                  (type_name
                    (name "undefined")))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Describes the currently selected completion item."
          "	 */"
          "	")
        (interface
          (identifier "SelectedCompletionInfo")
          (declarations_block
            (comment__
              ""
              "		/**"
              "		 * The range that will be replaced if this completion item is accepted."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "range")
              (types
                (type
                  (type_name
                    (name "Range")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The text the range will be replaced with if this completion is accepted."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "text")
              (types
                (type
                  (basic_type "string"))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Describes how an {@link InlineCompletionItemProvider inline completion provider} was triggered."
          "	 */"
          "	")
        (enum
          (identifier "InlineCompletionTriggerKind")
          (comment__
            ""
            "		/**"
            "		 * Completion was triggered explicitly by a user gesture."
            "		 * Return multiple completion items to enable cycling through them."
            "		 */"
            "		")
          (item
            (identifier "Invoke")
            (literal
              (integer "0")))
          (comment__
            ""
            ""
            "		/**"
            "		 * Completion was triggered automatically while editing."
            "		 * It is sufficient to return a single completion item in this case."
            "		 */"
            "		")
          (item
            (identifier "Automatic")
            (literal
              (integer "1"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * An inline completion item represents a text snippet that is proposed inline to complete text that is being typed."
          "	 *"
          "	 * @see {@link InlineCompletionItemProvider.provideInlineCompletionItems}"
          "	 */"
          "	")
        (interface
          (identifier "InlineCompletionItem")
          (declarations_block
            (comment__
              ""
              "		/**"
              "		 * The text to replace the range with. Must be set."
              "		 * Is used both for the preview and the accept operation."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "insertText")
              (types
                (type
                  (basic_type "string"))
                (type
                  (type_name
                    (name "SnippetString")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * A text that is used to decide if this inline completion should be shown. When `falsy`"
              "		 * the {@link InlineCompletionItem.insertText} is used."
              "		 *"
              "		 * An inline completion is shown if the text to replace is a prefix of the filter text."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "filterText")
              (optional "?")
              (types
                (type
                  (basic_type "string"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The range to replace."
              "		 * Must begin and end on the same line."
              "		 *"
              "		 * Prefer replacements over insertions to provide a better experience when the user deletes typed text."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "range")
              (optional "?")
              (types
                (type
