        (comment__
          ""
          ""
          "	/**"
          "	 * Contains coverage metadata for a file."
          "	 */"
          "	")
        (interface
          (identifier "FileCoverage")
          (declarations_block
            (comment__
              ""
              "		/**"
              "		 * File URI."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "uri")
              (types
                (type
                  (type_name
                    (name "Uri")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Statement coverage information. If the reporter does not provide statement"
              "		 * coverage information, this can instead be used to represent line coverage."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "statementCoverage")
              (types
                (type
                  (type_name
                    (name "TestCoverageCount")))))
            (comment__
