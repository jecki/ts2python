                  (type_name
                    (name "ViewColumn")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Scroll as indicated by `revealType` in order to reveal the given range."
              "		 *"
              "		 * @param range A range."
              "		 * @param revealType The scrolling strategy for revealing `range`."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "revealRange")
              (arg_list
                (argument
                  (identifier "range")
                  (types
                    (type
                      (type_name
                        (name "NotebookRange")))))
                (argument
                  (identifier "revealType")
                  (optional "?")
                  (types
                    (type
                      (type_name
                        (name "NotebookEditorRevealType"))))))
              (types
                (type
                  (basic_type "void"))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Renderer messaging is used to communicate with a single renderer. It's returned from {@link notebooks.createRendererMessaging}."
          "	 */"
          "	")
        (interface
          (identifier "NotebookRendererMessaging")
          (declarations_block
            (comment__
              ""
              "		/**"
              "		 * An event that fires when a message is received from a renderer."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "onDidReceiveMessage")
              (types
                (type
                  (generic_type
