                      (parameter_types
                        (parameter_type
                          (declarations_block
                            (comment__
                              ""
                              "			/**"
                              "			 * The {@link NotebookEditor editor} that sent the message."
                              "			 */"
                              "			")
                            (declaration
                              (qualifiers
                                (readonly "readonly"))
                              (identifier "editor")
                              (types
                                (type
                                  (type_name
                                    (name "NotebookEditor")))))
