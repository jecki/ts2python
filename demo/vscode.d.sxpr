              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "appendText")
              (arg_list
                (argument
                  (identifier "value")
                  (types
                    (type
                      (basic_type "string")))))
              (types
                (type
                  (type_name
                    (name "MarkdownString")))))
            (comment__
