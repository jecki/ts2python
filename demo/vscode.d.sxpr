                    (type_name
                      (name "DocumentSelector")))))
              (argument
                (identifier "provider")
                (types
                  (type
                    (type_name
                      (name "FoldingRangeProvider"))))))
            (types
              (type
                (type_name
                  (name "Disposable")))))
