        (comment__
          ""
          ""
          "	/**"
          "	 * The shell quoting options."
          "	 */"
          "	")
        (interface
          (identifier "ShellQuotingOptions")
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * The character used to do character escaping. If a string is provided only spaces"
              "		 * are escaped. If a `{ escapeChar, charsToEscape }` literal is provide all characters"
              "		 * in `charsToEscape` are escaped using the `escapeChar`."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "escape")
              (optional "?")
              (types
                (type
                  (basic_type "string"))
                (type
                  (declarations_block
                    (comment__
                      ""
                      "			/**"
                      "			 * The escape character."
                      "			 */"
                      "			")
                    (declaration
                      (qualifiers)
                      (identifier "escapeChar")
                      (types
                        (type
                          (basic_type "string"))))
                    (comment__
                      ""
                      "			/**"
                      "			 * The characters to escape."
                      "			 */"
                      "			")
                    (declaration
                      (qualifiers)
                      (identifier "charsToEscape")
                      (types
                        (type
                          (basic_type "string"))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The character used for strong quoting. The string's length must be 1."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "strong")
              (optional "?")
              (types
                (type
                  (basic_type "string"))))
            (comment__
