              (qualifiers)
              (identifier "parentSession")
              (optional "?")
              (types
                (type
                  (type_name
                    (name "DebugSession")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Controls whether lifecycle requests like 'restart' are sent to the newly created session or its parent session."
              "		 * By default (if the property is false or missing), lifecycle requests are sent to the new session."
              "		 * This property is ignored if the session has no parent session."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "lifecycleManagedByParent")
              (optional "?")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Controls whether this session should have a separate debug console or share it"
              "		 * with the parent session. Has no effect for sessions which do not have a parent session."
              "		 * Defaults to Separate."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "consoleMode")
              (optional "?")
              (types
                (type
                  (type_name
                    (name "DebugConsoleMode")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Controls whether this session should run without debugging, thus ignoring breakpoints."
              "		 * When this property is not specified, the value from the parent session (if there is one) is used."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "noDebug")
              (optional "?")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Controls if the debug session's parent session is shown in the CALL STACK view even if it has only a single child."
              "		 * By default, the debug session will never hide its parent."
              "		 * If compact is true, debug sessions with a single child are hidden in the CALL STACK view to make the tree more compact."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "compact")
              (optional "?")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * When true, a save will not be triggered for open editors when starting a debug session, regardless of the value of the `debug.saveBeforeStart` setting."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "suppressSaveBeforeStart")
              (optional "?")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * When true, the debug toolbar will not be shown for this session."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "suppressDebugToolbar")
              (optional "?")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * When true, the window statusbar color will not be changed for this session."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "suppressDebugStatusbar")
              (optional "?")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
