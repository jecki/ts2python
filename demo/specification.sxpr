                      (array_type
                        (type_name
                          (name "CompletionItemKind"))))))))))))
    (comment__
      ""
      ""
      "/**"
      " * The client supports the following `CompletionList` specific"
      " * capabilities."
      " *"
      " * @since 3.17.0"
      " */"
      "")
    (interface
      (identifier "CompletionListCapabilities")
      (declarations_block
        (comment__
          ""
          "	/**"
          "	 * The client supports the following itemDefaults on"
          "	 * a completion list."
          "	 *"
          "	 * The value lists the supported property names of the"
          "	 * `CompletionList.itemDefaults` object. If omitted"
          "	 * no properties are supported."
          "	 *"
          "	 * @since 3.17.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "itemDefaults")
          (optional "?")
          (types
            (type
              (array_of
                (array_types
                  (array_type
                    (basic_type "string")))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Specifies whether the client supports `CompletionList.applyKind` to"
          "	 * indicate how supported values from `completionList.itemDefaults`"
          "	 * and `completion` will be combined."
          "	 *"
          "	 * If a client supports `applyKind` it must support it for all fields"
          "	 * that it supports that are listed in `CompletionList.applyKind`. This"
          "	 * means when clients add support for new/future fields in completion"
          "	 * items the MUST also support merge for them if those fields are"
          "	 * defined in `CompletionList.applyKind`."
          "	 *"
          "	 * @since 3.18.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "applyKindSupport")
          (optional "?")
          (types
            (type
              (basic_type "boolean"))))))
    (comment__
      ""
      ""
      "/**"
      " * Completion options."
      " */"
      "")
    (interface
      (identifier "CompletionOptions")
      (extends
        (type_name
          (name "WorkDoneProgressOptions")))
      (declarations_block
        (comment__
          ""
          "	/**"
          "	 * Most tools trigger completion request automatically without explicitly"
          "	 * requesting it using a keyboard shortcut (e.g., Ctrl+Space). Typically they"
          "	 * do so when the user starts to type an identifier. For example, if the user"
          "	 * types `c` in a JavaScript file, code complete will automatically pop up and"
          "	 * present `console` besides others as a completion item. Characters that"
          "	 * make up identifiers don't need to be listed here."
          "	 *"
          "	 * If code complete should automatically be triggered on characters not being"
          "	 * valid inside an identifier (for example, `.` in JavaScript), list them in"
          "	 * `triggerCharacters`."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "triggerCharacters")
          (optional "?")
          (types
            (type
              (array_of
                (array_types
                  (array_type
                    (basic_type "string")))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * The list of all possible characters that commit a completion. This field"
          "	 * can be used if clients don't support individual commit characters per"
          "	 * completion item. See client capability"
          "	 * `completion.completionItem.commitCharactersSupport`."
          "	 *"
          "	 * If a server provides both `allCommitCharacters` and commit characters on"
          "	 * an individual completion item, the ones on the completion item win."
          "	 *"
          "	 * @since 3.2.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "allCommitCharacters")
          (optional "?")
          (types
            (type
              (array_of
                (array_types
                  (array_type
                    (basic_type "string")))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * The server provides support to resolve additional"
          "	 * information for a completion item."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "resolveProvider")
          (optional "?")
          (types
            (type
              (basic_type "boolean"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * The server supports the following `CompletionItem` specific"
          "	 * capabilities."
          "	 *"
          "	 * @since 3.17.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "completionItem")
          (optional "?")
          (types
            (type
              (type_name
                (name "ServerCompletionItemOptions")))))))
    (type_alias
      (identifier "ServerCompletionItemOptions")
      (types
        (type
          (declarations_block
            (comment__
              ""
              "	/**"
              "	 * The server has support for completion item label"
              "	 * details (see also `CompletionItemLabelDetails`) when"
              "	 * receiving a completion item in a resolve call."
              "	 *"
              "	 * @since 3.17.0"
              "	 */"
              "	")
            (declaration
              (qualifiers)
              (identifier "labelDetailsSupport")
              (optional "?")
              (types
                (type
                  (basic_type "boolean"))))))))
    (interface
      (identifier "CompletionRegistrationOptions")
      (extends
        (type_name
          (name "TextDocumentRegistrationOptions"))
        (type_name
          (name "CompletionOptions")))
      (declarations_block))
    (interface
      (identifier "CompletionParams")
      (extends
        (type_name
          (name "TextDocumentPositionParams"))
        (type_name
          (name "WorkDoneProgressParams"))
        (type_name
          (name "PartialResultParams")))
      (declarations_block
        (comment__
          ""
          "	/**"
          "	 * The completion context. This is only available if the client specifies"
          "	 * to send this using the client capability"
          "	 * `completion.contextSupport === true`"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "context")
          (optional "?")
          (types
            (type
              (type_name
                (name "CompletionContext")))))))
    (comment__
      ""
      ""
      "/**"
      " * How a completion was triggered."
      " */"
      "")
    (virtual_enum
      (identifier "CompletionTriggerKind")
      (comment__
        ""
        "	/**"
        "	 * Completion was triggered by typing an identifier (automatic code"
        "	 * complete), manual invocation (e.g. Ctrl+Space) or via API."
        "	 */"
        "	")
      (const
        (declaration
          (qualifiers)
          (identifier "Invoked")
          (types
            (type
              (literal
                (integer "1")))))
        (literal
          (integer "1")))
      (comment__
        ""
        ""
        "	/**"
        "	 * Completion was triggered by a trigger character specified by"
        "	 * the `triggerCharacters` properties of the"
        "	 * `CompletionRegistrationOptions`."
        "	 */"
        "	")
      (const
        (declaration
          (qualifiers)
          (identifier "TriggerCharacter")
          (types
            (type
              (literal
                (integer "2")))))
        (literal
          (integer "2")))
      (comment__
        ""
        ""
        "	/**"
        "	 * Completion was re-triggered as the current completion list is incomplete."
        "	 */"
        "	")
      (const
        (declaration
          (qualifiers)
          (identifier "TriggerForIncompleteCompletions")
          (types
            (type
              (literal
                (integer "3")))))
        (literal
          (integer "3"))))
    (type_alias
      (identifier "CompletionTriggerKind")
      (types
        (type
          (literal
            (integer "1")))
        (type
          (literal
            (integer "2")))
        (type
          (literal
            (integer "3")))))
    (comment__
      ""
      ""
      "/**"
      " * Contains additional information about the context in which a completion"
      " * request is triggered."
      " */"
      "")
    (interface
      (identifier "CompletionContext")
      (declarations_block
        (comment__
          ""
          "	/**"
          "	 * How the completion was triggered."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "triggerKind")
          (types
            (type
              (type_name
                (name "CompletionTriggerKind")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * The trigger character (a single character) that"
          "	 * has triggered code complete. Is undefined if"
          "	 * `triggerKind !== CompletionTriggerKind.TriggerCharacter`"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "triggerCharacter")
          (optional "?")
          (types
            (type
              (basic_type "string"))))))
    (comment__
      ""
      ""
      "/**"
      " * Edit range variant that includes ranges for insert and replace operations."
      " */"
      "")
    (type_alias
      (identifier "EditRangeWithInsertReplace")
      (types
        (type
          (declarations_block
            (declaration
              (qualifiers)
              (identifier "insert")
              (types
                (type
                  (type_name
                    (name "Range")))))
            (declaration
              (qualifiers)
              (identifier "replace")
              (types
                (type
                  (type_name
                    (name "Range")))))))))
    (comment__
      ""
      ""
      "/**"
      " * Represents a collection of [completion items](#CompletionItem) to be"
      " * presented in the editor."
      " */"
      "")
    (interface
      (identifier "CompletionList")
      (declarations_block
        (comment__
          ""
          "	/**"
          "	 * This list is not complete. Further typing should result in recomputing"
          "	 * this list."
          "	 *"
          "	 * Recomputed lists have all their items replaced (not appended) in the"
          "	 * incomplete completion sessions."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "isIncomplete")
          (types
            (type
              (basic_type "boolean"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * In many cases, the items of an actual completion result share the same"
          "	 * value for properties like `commitCharacters` or the range of a text"
          "	 * edit. A completion list can therefore define item defaults which will"
          "	 * be used if a completion item itself doesn't specify the value."
          "	 *"
          "	 * If a completion list specifies a default value and a completion item"
          "	 * also specifies a corresponding value, the rules for combining these are"
          "	 * defined by `applyKinds` (if the client supports it), defaulting to"
          "	 * ApplyKind.Replace."
          "	 *"
          "	 * Servers are only allowed to return default values if the client"
          "	 * signals support for this via the `completionList.itemDefaults`"
          "	 * capability."
          "	 *"
          "	 * @since 3.17.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "itemDefaults")
          (optional "?")
          (types
            (type
              (type_name
                (name
                  (:_part "CompletionItemDefaults"))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Specifies how fields from a completion item should be combined with those"
          "	 * from `completionList.itemDefaults`."
          "	 *"
          "	 * If unspecified, all fields will be treated as ApplyKind.Replace."
          "	 *"
          "	 * If a field's value is ApplyKind.Replace, the value from a completion item"
          "	 * (if provided and not `null`) will always be used instead of the value"
          "	 * from `completionItem.itemDefaults`."
          "	 *"
          "	 * If a field's value is ApplyKind.Merge, the values will be merged using"
          "	 * the rules defined against each field below."
          "	 *"
          "	 * Servers are only allowed to return `applyKind` if the client"
          "	 * signals support for this via the `completionList.applyKindSupport`"
          "	 * capability."
          "	 *"
          "	 * @since 3.18.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "applyKind")
          (optional "?")
          (types
            (type
              (type_name
                (name "CompletionItemApplyKinds")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * The completion items."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "items")
          (types
            (type
              (array_of
                (array_types
                  (array_type
                    (type_name
                      (name "CompletionItem"))))))))))
    (comment__
      ""
      ""
      "/**"
      " * In many cases the items of an actual completion result share the same"
      " * value for properties like `commitCharacters` or the range of a text"
      " * edit. A completion list can therefore define item defaults which will"
      " * be used if a completion item itself doesn't specify the value."
      " *"
      " * If a completion list specifies a default value and a completion item"
      " * also specifies a corresponding value, the rules for combining these are"
      " * defined by `applyKinds` (if the client supports it), defaulting to"
      " * ApplyKind.Replace."
      " *"
      " * Servers are only allowed to return default values if the client"
      " * signals support for this via the `completionList.itemDefaults`"
      " * capability."
      " *"
      " * @since 3.17.0"
      " */"
      "")
    (interface
      (identifier "CompletionItemDefaults")
      (declarations_block
        (comment__
          ""
          "	/**"
          "	 * A default commit character set."
          "	 *"
          "	 * @since 3.17.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "commitCharacters")
          (optional "?")
          (types
            (type
              (array_of
                (array_types
                  (array_type
                    (basic_type "string")))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * A default edit range."
          "	 *"
          "	 * @since 3.17.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "editRange")
          (optional "?")
          (types
            (type
              (type_name
                (name "Range")))
            (type
              (type_name
                (name "EditRangeWithInsertReplace")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * A default insert text format."
          "	 *"
          "	 * @since 3.17.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "insertTextFormat")
          (optional "?")
          (types
            (type
              (type_name
                (name "InsertTextFormat")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * A default insert text mode."
          "	 *"
          "	 * @since 3.17.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "insertTextMode")
          (optional "?")
          (types
            (type
              (type_name
                (name "InsertTextMode")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * A default data value."
          "	 *"
          "	 * @since 3.17.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "data")
          (optional "?")
          (types
            (type
              (type_name
                (name "LSPAny")))))))
    (comment__
      ""
      ""
      "/**"
      " * Specifies how fields from a completion item should be combined with those"
      " * from `completionList.itemDefaults`."
      " *"
      " * If unspecified, all fields will be treated as ApplyKind.Replace."
      " *"
      " * If a field's value is ApplyKind.Replace, the value from a completion item (if"
      " * provided and not `null`) will always be used instead of the value from"
      " * `completionItem.itemDefaults`."
      " *"
      " * If a field's value is ApplyKind.Merge, the values will be merged using the rules"
      " * defined against each field below."
      " *"
      " * Servers are only allowed to return `applyKind` if the client"
      " * signals support for this via the `completionList.applyKindSupport`"
      " * capability."
      " *"
      " * @since 3.18.0"
      " */"
      "")
    (interface
      (identifier "CompletionItemApplyKinds")
      (declarations_block
        (comment__
          ""
          "	/**"
          "	 * Specifies whether commitCharacters on a completion will replace or be"
          "	 * merged with those in `completionList.itemDefaults.commitCharacters`."
          "	 *"
          "	 * If ApplyKind.Replace, the commit characters from the completion item will"
          "	 * always be used unless not provided, in which case those from"
          "	 * `completionList.itemDefaults.commitCharacters` will be used. An"
          "	 * empty list can be used if a completion item does not have any commit"
          "	 * characters and also should not use those from"
          "	 * `completionList.itemDefaults.commitCharacters`."
          "	 *"
          "	 * If ApplyKind.Merge the commitCharacters for the completion will be the"
          "	 * union of all values in both `completionList.itemDefaults.commitCharacters`"
          "	 * and the completion's own `commitCharacters`."
          "	 *"
          "	 * @since 3.18.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "commitCharacters")
          (optional "?")
          (types
            (type
              (type_name
                (name "ApplyKind")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Specifies whether the `data` field on a completion will replace or"
          "	 * be merged with data from `completionList.itemDefaults.data`."
          "	 *"
          "	 * If ApplyKind.Replace, the data from the completion item will be used if"
          "	 * provided (and not `null`), otherwise"
          "	 * `completionList.itemDefaults.data` will be used. An empty object can"
          "	 * be used if a completion item does not have any data but also should"
          "	 * not use the value from `completionList.itemDefaults.data`."
          "	 *"
          "	 * If ApplyKind.Merge, a shallow merge will be performed between"
          "	 * `completionList.itemDefaults.data` and the completion's own data"
          "	 * using the following rules:"
          "	 *"
          "	 * - If a completion's `data` field is not provided (or `null`), the"
          "	 *   entire `data` field from `completionList.itemDefaults.data` will be"
          "	 *   used as-is."
          "	 * - If a completion's `data` field is provided, each field will"
          "	 *   overwrite the field of the same name in"
          "	 *   `completionList.itemDefaults.data` but no merging of nested fields"
          "	 *   within that value will occur."
          "	 *"
          "	 * @since 3.18.0"
          "	 */"
