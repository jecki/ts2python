              (qualifiers)
              (identifier "indentationRules")
              (optional "?")
              (types
                (type
                  (type_name
                    (name "IndentationRule")))))
            (comment__
              ""
              "		/**"
              "		 * The language's rules to be evaluated when pressing Enter."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "onEnterRules")
              (optional "?")
              (types
                (type
                  (array_of
                    (array_types
                      (array_type
                        (type_name
                          (name "OnEnterRule"))))))))
            (comment__
