        (comment__
          ""
          ""
          "	/**"
          "	 * Inlay hint kinds."
          "	 *"
          "	 * The kind of an inline hint defines its appearance, e.g the corresponding foreground and background colors are being"
          "	 * used."
          "	 */"
          "	")
        (enum
          (identifier "InlayHintKind")
          (comment__
            ""
            "		/**"
            "		 * An inlay hint that is for a type annotation."
            "		 */"
            "		")
          (item
            (identifier "Type")
            (literal
              (integer "1")))
          (comment__
            ""
            "		/**"
            "		 * An inlay hint that is for a parameter."
            "		 */"
            "		")
          (item
            (identifier "Parameter")
            (literal
              (integer "2"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * An inlay hint label part allows for interactive and composite labels of inlay hints."
          "	 */"
          "	")
        (interface
          (identifier "InlayHintLabelPart")
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * The value of this label part."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "value")
              (types
                (type
                  (basic_type "string"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The tooltip text when you hover over this label part."
              "		 *"
              "		 * *Note* that this property can be set late during"
              "		 * {@link InlayHintsProvider.resolveInlayHint resolving} of inlay hints."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "tooltip")
              (optional "?")
              (types
                (type
                  (basic_type "string"))
                (type
                  (type_name
                    (name "MarkdownString")))
                (type
                  (type_name
                    (name "undefined")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * An optional {@link Location source code location} that represents this label"
              "		 * part."
              "		 *"
              "		 * The editor will use this location for the hover and for code navigation features: This"
              "		 * part will become a clickable link that resolves to the definition of the symbol at the"
              "		 * given location (not necessarily the location itself), it shows the hover that shows at"
              "		 * the given location, and it shows a context menu with further code navigation commands."
              "		 *"
              "		 * *Note* that this property can be set late during"
              "		 * {@link InlayHintsProvider.resolveInlayHint resolving} of inlay hints."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "location")
              (optional "?")
              (types
                (type
                  (type_name
                    (name "Location")))
                (type
                  (type_name
                    (name "undefined")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * An optional command for this label part."
              "		 *"
              "		 * The editor renders parts with commands as clickable links. The command is added to the context menu"
              "		 * when a label part defines {@link InlayHintLabelPart.location location} and {@link InlayHintLabelPart.command command} ."
              "		 *"
              "		 * *Note* that this property can be set late during"
              "		 * {@link InlayHintsProvider.resolveInlayHint resolving} of inlay hints."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "command")
              (optional "?")
              (types
                (type
                  (type_name
                    (name "Command")))
                (type
                  (type_name
                    (name "undefined")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Creates a new inlay hint label part."
              "		 *"
              "		 * @param value The value of the part."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "constructor")
              (arg_list
                (argument
                  (identifier "value")
                  (types
                    (type
                      (basic_type "string"))))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Inlay hint information."
          "	 */"
          "	")
        (interface
          (identifier "InlayHint")
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * The position of this hint."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "position")
              (types
                (type
                  (type_name
                    (name "Position")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The label of this hint. A human readable string or an array of {@link InlayHintLabelPart label parts}."
              "		 *"
              "		 * *Note* that neither the string nor the label part can be empty."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "label")
              (types
                (type
                  (basic_type "string"))
                (type
                  (array_of
                    (array_types
                      (array_type
                        (type_name
                          (name "InlayHintLabelPart"))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The tooltip text when you hover over this item."
              "		 *"
              "		 * *Note* that this property can be set late during"
              "		 * {@link InlayHintsProvider.resolveInlayHint resolving} of inlay hints."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "tooltip")
              (optional "?")
              (types
                (type
                  (basic_type "string"))
                (type
                  (type_name
                    (name "MarkdownString")))
                (type
                  (type_name
                    (name "undefined")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The kind of this hint. The inlay hint kind defines the appearance of this inlay hint."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "kind")
              (optional "?")
              (types
                (type
                  (type_name
                    (name "InlayHintKind")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Optional {@link TextEdit text edits} that are performed when accepting this inlay hint. The default"
              "		 * gesture for accepting an inlay hint is the double click."
              "		 *"
              "		 * *Note* that edits are expected to change the document so that the inlay hint (or its nearest variant) is"
              "		 * now part of the document and the inlay hint itself is now obsolete."
              "		 *"
              "		 * *Note* that this property can be set late during"
              "		 * {@link InlayHintsProvider.resolveInlayHint resolving} of inlay hints."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "textEdits")
              (optional "?")
              (types
                (type
                  (array_of
                    (array_types
                      (array_type
                        (type_name
                          (name "TextEdit"))))))))
            (comment__
