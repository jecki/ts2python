          ""
          "	/**"
          "	 * A type of mutation and its value to be applied to an environment variable."
          "	 */"
          "	")
        (interface
          (identifier "EnvironmentVariableMutator")
          (declarations_block
            (comment__
              ""
              "		/**"
              "		 * The type of mutation that will occur to the variable."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "type")
