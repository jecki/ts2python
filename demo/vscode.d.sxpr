                                  (type
                                    (type_name
                                      (name "SnippetString"))))))
                            (types
                              (type
                                (basic_type "any")))))))))
                (argument
                  (identifier "number")
                  (optional "?")
                  (types
                    (type
                      (basic_type "number")))))
              (types
                (type
