              ""
              "		/**"
              "		 * The {@link TerminalLocation} or {@link TerminalEditorLocationOptions} or {@link TerminalSplitLocationOptions} for the terminal."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "location")
              (optional "?")
              (types
