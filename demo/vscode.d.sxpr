                    (type_name
                      (name "DocumentSemanticTokensProvider")))))
              (argument
                (identifier "legend")
                (types
                  (type
                    (type_name
                      (name "SemanticTokensLegend"))))))
            (types
              (type
                (type_name
                  (name "Disposable")))))
          (comment__
            ""
            ""
            "		/**"
            "		 * Register a semantic tokens provider for a document range."
            "		 *"
            "		 * *Note:* If a document has both a `DocumentSemanticTokensProvider` and a `DocumentRangeSemanticTokensProvider`,"
            "		 * the range provider will be invoked only initially, for the time in which the full document provider takes"
            "		 * to resolve the first request. Once the full document provider resolves the first request, the semantic tokens"
            "		 * provided via the range provider will be discarded and from that point forward, only the document provider"
            "		 * will be used."
            "		 *"
            "		 * Multiple providers can be registered for a language. In that case providers are sorted"
            "		 * by their {@link languages.match score} and the best-matching provider is used. Failure"
            "		 * of the selected provider will cause a failure of the whole operation."
            "		 *"
            "		 * @param selector A selector that defines the documents this provider is applicable to."
            "		 * @param provider A document range semantic tokens provider."
            "		 * @returns A {@link Disposable} that unregisters this provider when being disposed."
            "		 */"
            "		")
          (function
            (qualifiers)
            (identifier "registerDocumentRangeSemanticTokensProvider")
            (arg_list
              (argument
                (identifier "selector")
                (types
                  (type
                    (type_name
                      (name "DocumentSelector")))))
              (argument
                (identifier "provider")
                (types
                  (type
                    (type_name
                      (name "DocumentRangeSemanticTokensProvider")))))
              (argument
                (identifier "legend")
                (types
                  (type
                    (type_name
                      (name "SemanticTokensLegend"))))))
            (types
              (type
                (type_name
                  (name "Disposable")))))
