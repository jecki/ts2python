        "	 * Applying the workspace change is simply aborted if one of the changes"
        "	 * provided fails. All operations executed before the failing operation"
        "	 * stay executed."
        "	 */"
        "	")
      (const
        (declaration
          (qualifiers)
          (identifier "Abort")
          (types
            (type
              (type_name
                (name "FailureHandlingKind")))))
        (literal
          (string "'abort'")))
      (comment__
        ""
        ""
        "	/**"
        "	 * All operations are executed transactionally. That means they either all"
        "	 * succeed or no changes at all are applied to the workspace."
        "	 */"
        "	")
      (const
        (declaration
          (qualifiers)
          (identifier "Transactional")
          (types
            (type
              (type_name
                (name "FailureHandlingKind")))))
        (literal
          (string "'transactional'")))
      (comment__
        ""
        ""
        ""
        "	/**"
        "	 * If the workspace edit contains only textual file changes they are"
        "	 * executed transactionally. If resource changes (create, rename or delete"
        "	 * file) are part of the change the failure handling strategy is abort."
        "	 */"
        "	")
      (const
        (declaration
          (qualifiers)
          (identifier "TextOnlyTransactional")
          (types
            (type
              (type_name
                (name "FailureHandlingKind")))))
        (literal
          (string "'textOnlyTransactional'")))
      (comment__
        ""
        ""
        "	/**"
        "	 * The client tries to undo the operations already executed. But there is no"
        "	 * guarantee that this is succeeding."
        "	 */"
        "	")
      (const
        (declaration
          (qualifiers)
          (identifier "Undo")
          (types
            (type
              (type_name
                (name "FailureHandlingKind")))))
        (literal
          (string "'undo'"))))
    (comment__
      ""
      ""
      ""
      '/* source file: "types/workDoneProgress.md" */'
      ""
      "")
    (interface
      (identifier "WorkDoneProgressBegin")
      (declarations_block
        (declaration
          (qualifiers)
          (identifier "kind")
          (types
            (type
              (literal
                (string "'begin'")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Mandatory title of the progress operation. Used to briefly inform about"
          "	 * the kind of operation being performed."
          "	 *"
          '	 * Examples: "Indexing" or "Linking dependencies".'
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "title")
          (types
            (type
              (basic_type "string"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Controls if a cancel button should be shown to allow the user to cancel"
          "	 * the long running operation. Clients that don't support cancellation are"
          "	 * allowed to ignore the setting."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "cancellable")
          (optional "?")
          (types
            (type
              (basic_type "boolean"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Optional, more detailed associated progress message. Contains"
          "	 * complementary information to the `title`."
          "	 *"
          '	 * Examples: "3/25 files", "project/src/module2", "node_modules/some_dep".'
          "	 * If unset, the previous progress message (if any) is still valid."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "message")
          (optional "?")
          (types
            (type
              (basic_type "string"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Optional progress percentage to display (value 100 is considered 100%)."
          "	 * If not provided infinite progress is assumed and clients are allowed"
          "	 * to ignore the `percentage` value in subsequent report notifications."
          "	 *"
          "	 * The value should be steadily rising. Clients are free to ignore values"
          "	 * that are not following this rule. The value range is [0, 100]."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "percentage")
          (optional "?")
          (types
            (type
              (basic_type "uinteger"))))))
