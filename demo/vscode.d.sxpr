              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "requestHandler")
              (types
                (type
                  (type_name
                    (name "ChatRequestHandler")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * This provider will be called once after each request to retrieve suggested followup questions."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "followupProvider")
              (optional "?")
              (types
                (type
                  (type_name
                    (name "ChatFollowupProvider")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * An event that fires whenever feedback for a result is received, e.g. when a user up- or down-votes"
              "		 * a result."
              "		 *"
              "		 * The passed {@link ChatResultFeedback.result result} is guaranteed to have the same properties as the result that was"
              "		 * previously returned from this chat participant's handler."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "onDidReceiveFeedback")
              (types
                (type
                  (generic_type
                    (type_name
                      (name "Event"))
                    (type_parameters
                      (parameter_types
                        (parameter_type
                          (type_name
                            (name "ChatResultFeedback")))))))))
            (comment__
