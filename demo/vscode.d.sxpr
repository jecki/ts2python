                      (type_name
                        (name "CancellationToken"))))))
              (types
                (type
                  (generic_type
                    (type_name
                      (name "Thenable"))
                    (type_parameters
                      (parameter_types
                        (parameter_type
                          (basic_type "number"))))))))))
        (comment__
          ""
          ""
          "	/**"
