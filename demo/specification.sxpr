    (comment__
      ""
      ""
      "/**"
      " * Inlay hint information."
      " *"
      " * @since 3.17.0"
      " */"
      "")
    (interface
      (identifier "InlayHint")
      (declarations_block
        (comment__
          ""
          ""
          "	/**"
          "	 * The position of this hint."
          "	 *"
          "	 * If multiple hints have the same position, they will be shown in the order"
          "	 * they appear in the response."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "position")
          (types
            (type
              (type_name
                (name "Position")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * The label of this hint. A human readable string or an array of"
          "	 * InlayHintLabelPart label parts."
          "	 *"
          "	 * *Note* that neither the string nor the label part can be empty."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "label")
          (types
            (type
              (basic_type "string"))
            (type
              (array_of
                (array_types
                  (array_type
                    (type_name
                      (name "InlayHintLabelPart"))))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * The kind of this hint. Can be omitted in which case the client"
          "	 * should fall back to a reasonable default."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "kind")
          (optional "?")
          (types
            (type
              (type_name
                (name "InlayHintKind")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Optional text edits that are performed when accepting this inlay hint."
          "	 *"
          "	 * *Note* that edits are expected to change the document so that the inlay"
          "	 * hint (or its nearest variant) is now part of the document and the inlay"
          "	 * hint itself is now obsolete."
          "	 *"
          "	 * Depending on the client capability `inlayHint.resolveSupport`,"
          "	 * clients might resolve this property late using the resolve request."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "textEdits")
          (optional "?")
          (types
            (type
              (array_of
                (array_types
                  (array_type
                    (type_name
                      (name "TextEdit"))))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * The tooltip text when you hover over this item."
          "	 *"
          "	 * Depending on the client capability `inlayHint.resolveSupport` clients"
          "	 * might resolve this property late using the resolve request."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "tooltip")
          (optional "?")
          (types
            (type
              (basic_type "string"))
            (type
              (type_name
                (name "MarkupContent")))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Render padding before the hint."
          "	 *"
          "	 * Note: Padding should use the editor's background color, not the"
          "	 * background color of the hint itself. That means padding can be used"
          "	 * to visually align/separate an inlay hint."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "paddingLeft")
          (optional "?")
          (types
            (type
              (basic_type "boolean"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Render padding after the hint."
          "	 *"
          "	 * Note: Padding should use the editor's background color, not the"
          "	 * background color of the hint itself. That means padding can be used"
          "	 * to visually align/separate an inlay hint."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "paddingRight")
          (optional "?")
          (types
            (type
              (basic_type "boolean"))))
        (comment__
          ""
          ""
          ""
          "	/**"
          "	 * A data entry field that is preserved on an inlay hint between"
          "	 * a `textDocument/inlayHint` and an `inlayHint/resolve` request."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "data")
          (optional "?")
          (types
            (type
              (type_name
                (name "LSPAny")))))))
    (comment__
      ""
      ""
      "/**"
      " * An inlay hint label part allows for interactive and composite labels"
      " * of inlay hints."
      " *"
      " * @since 3.17.0"
      " */"
      "")
    (interface
      (identifier "InlayHintLabelPart")
      (declarations_block
        (comment__
