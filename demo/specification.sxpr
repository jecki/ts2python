      (identifier "CodeLens")
      (declarations_block
        (comment__
          ""
          "	/**"
          "	 * The range in which this code lens is valid. Should only span a single"
          "	 * line."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "range")
          (types
            (type
              (type_name
                (name "Range")))))
