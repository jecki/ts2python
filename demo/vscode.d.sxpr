              "		 * Default to `false`."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "canResolveChildren")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              '		 * Controls whether the item is shown as "busy" in the Test Explorer view.'
              "		 * This is useful for showing status while discovering children."
              "		 *"
              "		 * Defaults to `false`."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "busy")
              (types
