                  (array_of
                    (array_types
                      (array_type
                        (type_name
                          (name "MarkupKind"))))))))
            (comment__
              ""
              ""
              "	/**"
              "	 * Client supports the deprecated property on a completion item."
              "	 */"
              "	")
            (declaration
              (qualifiers)
              (identifier "deprecatedSupport")
              (optional "?")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "	/**"
              "	 * Client supports the preselect property on a completion item."
              "	 */"
              "	")
            (declaration
              (qualifiers)
              (identifier "preselectSupport")
              (optional "?")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "	/**"
              "	 * Client supports the tag property on a completion item. Clients supporting"
              "	 * tags have to handle unknown tags gracefully. Clients especially need to"
              "	 * preserve unknown tags when sending a completion item back to the server in"
              "	 * a resolve call."
              "	 *"
              "	 * @since 3.15.0"
              "	 */"
              "	")
            (declaration
              (qualifiers)
              (identifier "tagSupport")
              (optional "?")
              (types
                (type
                  (type_name
                    (name "CompletionItemTagOptions")))))
            (comment__
              ""
              ""
              "	/**"
              "	 * Client support insert replace edit to control different behavior if a"
              "	 * completion item is inserted in the text or should replace text."
              "	 *"
              "	 * @since 3.16.0"
              "	 */"
              "	")
            (declaration
              (qualifiers)
              (identifier "insertReplaceSupport")
              (optional "?")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "	/**"
              "	 * Indicates which properties a client can resolve lazily on a completion"
              "	 * item. Before version 3.16.0 only the predefined properties `documentation`"
              "	 * and `details` could be resolved lazily."
              "	 *"
              "	 * @since 3.16.0"
              "	 */"
              "	")
            (declaration
              (qualifiers)
              (identifier "resolveSupport")
              (optional "?")
              (types
                (type
                  (type_name
                    (name "ClientCompletionItemResolveOptions")))))
            (comment__
              ""
              ""
              "	/**"
              "	 * The client supports the `insertTextMode` property on"
              "	 * a completion item to override the whitespace handling mode"
              "	 * as defined by the client (see `insertTextMode`)."
              "	 *"
              "	 * @since 3.16.0"
              "	 */"
              "	")
            (declaration
              (qualifiers)
              (identifier "insertTextModeSupport")
              (optional "?")
              (types
                (type
                  (type_name
                    (name "ClientCompletionItemInsertTextModeOptions")))))
            (comment__
              ""
              ""
              "	/**"
              "	 * The client has support for completion item label"
              "	 * details (see also `CompletionItemLabelDetails`)."
              "	 *"
              "	 * @since 3.17.0"
              "	 */"
              "	")
            (declaration
              (qualifiers)
              (identifier "labelDetailsSupport")
              (optional "?")
              (types
                (type
                  (basic_type "boolean"))))))))
