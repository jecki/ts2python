        (comment__
          ""
          ""
          "	/**"
          "	 * Options to configure the behavior of a file open dialog."
          "	 *"
          "	 * * Note 1: On Windows and Linux, a file dialog cannot be both a file selector and a folder selector, so if you"
          "	 * set both `canSelectFiles` and `canSelectFolders` to `true` on these platforms, a folder selector will be shown."
          "	 * * Note 2: Explicitly setting `canSelectFiles` and `canSelectFolders` to `false` is futile"
          "	 * and the editor then silently adjusts the options to select files."
          "	 */"
          "	")
        (interface
          (identifier "OpenDialogOptions")
          (declarations_block
            (comment__
              ""
              "		/**"
              "		 * The resource the dialog shows when opened."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "defaultUri")
              (optional "?")
              (types
                (type
                  (type_name
                    (name "Uri")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * A human-readable string for the open button."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "openLabel")
              (optional "?")
              (types
                (type
                  (basic_type "string"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Allow to select files, defaults to `true`."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "canSelectFiles")
              (optional "?")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Allow to select folders, defaults to `false`."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "canSelectFolders")
              (optional "?")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Allow to select many files or folders."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "canSelectMany")
              (optional "?")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * A set of file filters that are used by the dialog. Each entry is a human-readable label,"
              '		 * like "TypeScript", and an array of extensions, for example:'
              "		 * ```ts"
              "		 * {"
              "		 * 	'Images': ['png', 'jpg'],"
              "		 * 	'TypeScript': ['ts', 'tsx']"
              "		 * }"
              "		 * ```"
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "filters")
              (optional "?")
              (types
