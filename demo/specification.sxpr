          ""
          "	/**"
          "	 * A data entry field that is preserved on a completion item between"
          "	 * a completion and a completion resolve request."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "data")
          (optional "?")
          (types
