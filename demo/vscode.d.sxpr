        (comment__
          ""
          ""
          "	/**"
          "	 * Represents different {@link TextEditor.revealRange reveal} strategies in a text editor."
          "	 */"
          "	")
        (enum
          (identifier "TextEditorRevealType")
          (comment__
            ""
            "		/**"
            "		 * The range will be revealed with as little scrolling as possible."
            "		 */"
            "		")
          (item
            (identifier "Default")
            (literal
              (integer "0")))
          (comment__
            ""
            "		/**"
            "		 * The range will always be revealed in the center of the viewport."
            "		 */"
            "		")
          (item
            (identifier "InCenter")
            (literal
              (integer "1")))
          (comment__
            ""
            "		/**"
            "		 * If the range is outside the viewport, it will be revealed in the center of the viewport."
            "		 * Otherwise, it will be revealed with as little scrolling as possible."
            "		 */"
            "		")
          (item
            (identifier "InCenterIfOutsideViewport")
            (literal
              (integer "2")))
          (comment__
            ""
            "		/**"
            "		 * The range will always be revealed at the top of the viewport."
            "		 */"
            "		")
          (item
            (identifier "AtTop")
            (literal
              (integer "3"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Represents different positions for rendering a decoration in an {@link DecorationRenderOptions.overviewRulerLane overview ruler}."
          "	 * The overview ruler supports three lanes."
          "	 */"
          "	")
        (enum
          (identifier "OverviewRulerLane")
          (comment__
            ""
            "		/**"
            "		 * The left lane of the overview ruler."
            "		 */"
            "		")
          (item
            (identifier "Left")
            (literal
              (integer "1")))
          (comment__
            ""
            "		/**"
            "		 * The center lane of the overview ruler."
            "		 */"
            "		")
          (item
            (identifier "Center")
            (literal
              (integer "2")))
          (comment__
            ""
            "		/**"
            "		 * The right lane of the overview ruler."
            "		 */"
            "		")
          (item
            (identifier "Right")
            (literal
              (integer "4")))
          (comment__
            ""
            "		/**"
            "		 * All lanes of the overview ruler."
            "		 */"
            "		")
          (item
            (identifier "Full")
            (literal
              (integer "7"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Describes the behavior of decorations when typing/editing at their edges."
          "	 */"
          "	")
        (enum
          (identifier "DecorationRangeBehavior")
          (comment__
            ""
            "		/**"
            "		 * The decoration's range will widen when edits occur at the start or end."
            "		 */"
            "		")
          (item
            (identifier "OpenOpen")
            (literal
              (integer "0")))
          (comment__
            ""
            "		/**"
            "		 * The decoration's range will not widen when edits occur at the start or end."
            "		 */"
            "		")
          (item
            (identifier "ClosedClosed")
            (literal
              (integer "1")))
          (comment__
            ""
            "		/**"
            "		 * The decoration's range will widen when edits occur at the start, but not at the end."
            "		 */"
            "		")
          (item
            (identifier "OpenClosed")
            (literal
              (integer "2")))
          (comment__
            ""
            "		/**"
            "		 * The decoration's range will widen when edits occur at the end, but not at the start."
            "		 */"
            "		")
          (item
            (identifier "ClosedOpen")
            (literal
              (integer "3"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Represents options to configure the behavior of showing a {@link TextDocument document} in an {@link TextEditor editor}."
          "	 */"
          "	")
        (interface
          (identifier "TextDocumentShowOptions")
          (declarations_block
            (comment__
              ""
              "		/**"
              "		 * An optional view column in which the {@link TextEditor editor} should be shown."
              "		 * The default is the {@link ViewColumn.Active active}. Columns that do not exist"
              "		 * will be created as needed up to the maximum of {@linkcode ViewColumn.Nine}."
              "		 * Use {@linkcode ViewColumn.Beside} to open the editor to the side of the currently"
              "		 * active one."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "viewColumn")
              (optional "?")
              (types
                (type
                  (type_name
                    (name "ViewColumn")))))
            (comment__
              ""
              ""
              "		/**"
