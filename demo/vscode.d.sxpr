        (comment__
          ""
          ""
          "	/**"
          "	 * A telemetry logger which can be used by extensions to log usage and error telemetry."
          "	 *"
          "	 * A logger wraps around an {@link TelemetrySender sender} but it guarantees that"
          "	 * - user settings to disable or tweak telemetry are respected, and that"
          "	 * - potential sensitive data is removed"
          "	 *"
          '	 * It also enables an "echo UI" that prints whatever data is send and it allows the editor'
          "	 * to forward unhandled errors to the respective extensions."
          "	 *"
          "	 * To get an instance of a `TelemetryLogger`, use"
          "	 * {@link env.createTelemetryLogger `createTelemetryLogger`}."
          "	 */"
          "	")
        (interface
          (identifier "TelemetryLogger")
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * An {@link Event} which fires when the enablement state of usage or error telemetry changes."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "onDidChangeEnableStates")
              (types
                (type
                  (generic_type
                    (type_name
                      (name "Event"))
                    (type_parameters
                      (parameter_types
                        (parameter_type
                          (type_name
                            (name "TelemetryLogger")))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Whether or not usage telemetry is enabled for this logger."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "isUsageEnabled")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Whether or not error telemetry is enabled for this logger."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "isErrorsEnabled")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Log a usage event."
              "		 *"
              "		 * After completing cleaning, telemetry setting checks, and data mix-in calls `TelemetrySender.sendEventData` to log the event."
              "		 * Automatically supports echoing to extension telemetry output channel."
              "		 * @param eventName The event name to log"
              "		 * @param data The data to log"
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "logUsage")
              (arg_list
                (argument
                  (identifier "eventName")
                  (types
                    (type
                      (basic_type "string"))))
                (argument
                  (identifier "data")
                  (optional "?")
                  (types
                    (type
                      (generic_type
                        (type_name
                          (name "Record"))
                        (type_parameters
                          (parameter_types
                            (parameter_type
                              (basic_type "string")))
                          (parameter_types
                            (parameter_type
                              (basic_type "any"))
                            (parameter_type
                              (type_name
                                (name "TelemetryTrustedValue"))))))))))
              (types
                (type
                  (basic_type "void"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Log an error event."
              "		 *"
              "		 * After completing cleaning, telemetry setting checks, and data mix-in calls `TelemetrySender.sendEventData` to log the event. Differs from `logUsage` in that it will log the event if the telemetry setting is Error+."
              "		 * Automatically supports echoing to extension telemetry output channel."
              "		 * @param eventName The event name to log"
              "		 * @param data The data to log"
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "logError")
              (arg_list
                (argument
                  (identifier "eventName")
