          ""
          "	/**"
          " 	 * Tags for this code action."
          "	 *"
          "	 * @since 3.18.0"
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "tags")
          (optional "?")
          (types
            (type
              (array_of
                (array_types
                  (array_type
                    (type_name
                      (name "CodeActionTag"))))))))))
