        (comment__
          ""
          ""
          "	/**"
          "	 * A collection of mutations that an extension can apply to a process environment."
          "	 */"
          "	")
        (interface
          (identifier "EnvironmentVariableCollection")
          (extends
            (generic_type
              (type_name
                (name "Iterable"))
              (type_parameters
                (parameter_types
                  (parameter_type
                    (declarations_tuple
                      (declaration
                        (qualifiers)
                        (identifier "iable")
