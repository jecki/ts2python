              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "dispose")
              (types
                (type
                  (basic_type "void"))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * A reference to a value that the user added to their chat request."
          "	 */"
          "	")
        (interface
          (identifier "ChatPromptReference")
          (declarations_block
            (comment__
              ""
              "		/**"
              "		 * A unique identifier for this kind of reference."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "id")
              (types
                (type
                  (basic_type "string"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The start and end index of the reference in the {@link ChatRequest.prompt prompt}. When undefined, the reference was not part of the prompt text."
              "		 *"
              "		 * *Note* that the indices take the leading `#`-character into account which means they can"
              "		 * used to modify the prompt as-is."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "range")
              (optional "?")
              (types
                (type
                  (declarations_tuple
                    (declaration
                      (qualifiers)
                      (identifier "start")
                      (types
                        (type
                          (basic_type "number"))))
                    (declaration
                      (qualifiers)
                      (identifier "end")
                      (types
                        (type
                          (basic_type "number"))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * A description of this value that could be used in an LLM prompt."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "modelDescription")
              (optional "?")
              (types
                (type
                  (basic_type "string"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The value of this reference. The `string | Uri | Location` types are used today, but this could expand in the future."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
