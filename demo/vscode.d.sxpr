        (comment__
          ""
          ""
          "	/**"
          "	 * A tool that can be invoked by a call to a {@link LanguageModelChat}."
          "	 */"
          "	")
        (interface
          (identifier "LanguageModelTool")
          (type_parameters
            (parameter_types
              (parameter_type
                (type_name
                  (name "T")))))
          (declarations_block
            (comment__
              ""
              "		/**"
              "		 * Invoke the tool with the given input and return a result."
              "		 *"
              "		 * The provided {@link LanguageModelToolInvocationOptions.input} has been validated against the declared schema."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "invoke")
              (arg_list
                (argument
                  (identifier "options")
                  (types
                    (type
                      (generic_type
                        (type_name
                          (name "LanguageModelToolInvocationOptions"))
                        (type_parameters
                          (parameter_types
                            (parameter_type
                              (type_name
                                (name "T")))))))))
                (argument
