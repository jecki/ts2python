                          (basic_type "string")))
                      (types
                        (type
                          (array_of
                            (array_types
                              (array_type
                                (basic_type "string")))))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Dialog title."
              "		 *"
              "		 * This parameter might be ignored, as not all operating systems display a title on open dialogs"
              "		 * (for example, macOS)."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "title")
              (optional "?")
              (types
                (type
                  (basic_type "string"))))))
