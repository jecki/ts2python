                (type
                  (basic_type "string"))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * The document formatting provider interface defines the contract between extensions and"
          "	 * the formatting-feature."
          "	 */"
          "	")
        (interface
          (identifier "DocumentFormattingEditProvider")
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * Provide formatting edits for a whole document."
              "		 *"
              "		 * @param document The document in which the command was invoked."
              "		 * @param options Options controlling formatting."
              "		 * @param token A cancellation token."
              "		 * @returns A set of text edits or a thenable that resolves to such. The lack of a result can be"
              "		 * signaled by returning `undefined`, `null`, or an empty array."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "provideDocumentFormattingEdits")
              (arg_list
                (argument
                  (identifier "document")
                  (types
                    (type
                      (type_name
                        (name "TextDocument")))))
                (argument
                  (identifier "options")
                  (types
                    (type
                      (type_name
                        (name "FormattingOptions")))))
                (argument
                  (identifier "token")
                  (types
                    (type
                      (type_name
                        (name "CancellationToken"))))))
              (types
                (type
                  (generic_type
                    (type_name
                      (name "ProviderResult"))
                    (type_parameters
                      (parameter_types
                        (parameter_type
                          (array_of
                            (array_types
                              (array_type
                                (type_name
                                  (name "TextEdit"))))))))))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * The document formatting provider interface defines the contract between extensions and"
          "	 * the formatting-feature."
          "	 */"
          "	")
        (interface
          (identifier "DocumentRangeFormattingEditProvider")
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * Provide formatting edits for a range in a document."
              "		 *"
              "		 * The given range is a hint and providers can decide to format a smaller"
              "		 * or larger range. Often this is done by adjusting the start and end"
              "		 * of the range to full syntax nodes."
              "		 *"
              "		 * @param document The document in which the command was invoked."
              "		 * @param range The range which should be formatted."
              "		 * @param options Options controlling formatting."
              "		 * @param token A cancellation token."
              "		 * @returns A set of text edits or a thenable that resolves to such. The lack of a result can be"
              "		 * signaled by returning `undefined`, `null`, or an empty array."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "provideDocumentRangeFormattingEdits")
              (arg_list
                (argument
                  (identifier "document")
                  (types
                    (type
                      (type_name
                        (name "TextDocument")))))
                (argument
                  (identifier "range")
                  (types
                    (type
                      (type_name
                        (name "Range")))))
                (argument
                  (identifier "options")
                  (types
                    (type
                      (type_name
                        (name "FormattingOptions")))))
                (argument
                  (identifier "token")
                  (types
                    (type
                      (type_name
                        (name "CancellationToken"))))))
              (types
                (type
                  (generic_type
                    (type_name
                      (name "ProviderResult"))
                    (type_parameters
                      (parameter_types
                        (parameter_type
                          (array_of
                            (array_types
                              (array_type
                                (type_name
                                  (name "TextEdit"))))))))))))
            (comment__
              ""
              ""
              ""
              "		/**"
              "		 * Provide formatting edits for multiple ranges in a document."
              "		 *"
              "		 * This function is optional but allows a formatter to perform faster when formatting only modified ranges or when"
              "		 * formatting a large number of selections."
              "		 *"
              "		 * The given ranges are hints and providers can decide to format a smaller"
              "		 * or larger range. Often this is done by adjusting the start and end"
              "		 * of the range to full syntax nodes."
              "		 *"
              "		 * @param document The document in which the command was invoked."
              "		 * @param ranges The ranges which should be formatted."
              "		 * @param options Options controlling formatting."
              "		 * @param token A cancellation token."
              "		 * @returns A set of text edits or a thenable that resolves to such. The lack of a result can be"
              "		 * signaled by returning `undefined`, `null`, or an empty array."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "provideDocumentRangesFormattingEdits")
              (optional "?")
              (arg_list
