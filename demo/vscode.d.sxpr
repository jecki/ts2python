        (comment__
          ""
          ""
          "	/**"
          "	 * Represents an editor that is attached to a {@link TextDocument document}."
          "	 */"
          "	")
        (interface
          (identifier "TextEditor")
          (declarations_block
            (comment__
              ""
              ""
              "		/**"
              "		 * The document associated with this text editor. The document will be the same for the entire lifetime of this text editor."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "document")
              (types
                (type
                  (type_name
                    (name "TextDocument")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The primary selection on this text editor. Shorthand for `TextEditor.selections[0]`."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "selection")
              (types
                (type
                  (type_name
                    (name "Selection")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The selections in this text editor. The primary selection is always at index 0."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "selections")
              (types
                (type
                  (readonly "readonly")
                  (array_of
                    (array_types
                      (array_type
                        (type_name
                          (name "Selection"))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The current visible ranges in the editor (vertically)."
              "		 * This accounts only for vertical scrolling, and not for horizontal scrolling."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "visibleRanges")
              (types
                (type
                  (readonly "readonly")
                  (array_of
                    (array_types
                      (array_type
                        (type_name
                          (name "Range"))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Text editor options."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "options")
              (types
                (type
                  (type_name
                    (name "TextEditorOptions")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * The column in which this editor shows. Will be `undefined` in case this"
              "		 * isn't one of the main editors, e.g. an embedded editor, or when the editor"
              "		 * column is larger than three."
              "		 */"
              "		")
            (declaration
              (qualifiers
                (readonly "readonly"))
              (identifier "viewColumn")
              (types
                (type
                  (type_name
                    (name "ViewColumn")))
                (type
                  (type_name
                    (name "undefined")))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Perform an edit on the document associated with this text editor."
              "		 *"
              "		 * The given callback-function is invoked with an {@link TextEditorEdit edit-builder} which must"
              "		 * be used to make edits. Note that the edit-builder is only valid while the"
              "		 * callback executes."
              "		 *"
              "		 * @param callback A function which can create edits using an {@link TextEditorEdit edit-builder}."
              "		 * @param options The undo/redo behavior around this edit. By default, undo stops will be created before and after this edit."
              "		 * @returns A promise that resolves with a value indicating if the edits could be applied."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "edit")
              (arg_list
                (argument
                  (identifier "callback")
                  (types
                    (type
                      (func_type
                        (arg_list
                          (argument
                            (identifier "editBuilder")
                            (types
                              (type
                                (type_name
                                  (name "TextEditorEdit"))))))
                        (types
                          (type
                            (basic_type "void")))))))
                (argument
                  (identifier "options")
                  (optional "?")
                  (types
                    (type
                      (declarations_block
                        (comment__
                          ""
                          "			/**"
                          "			 * Add undo stop before making the edits."
                          "			 */"
                          "			")
                        (declaration
                          (qualifiers
                            (readonly "readonly"))
                          (identifier "undoStopBefore")
                          (types
                            (type
                              (basic_type "boolean"))))
                        (comment__
                          ""
                          "			/**"
                          "			 * Add undo stop after making the edits."
                          "			 */"
                          "			")
                        (declaration
                          (qualifiers
                            (readonly "readonly"))
                          (identifier "undoStopAfter")
                          (types
                            (type
                              (basic_type "boolean")))))))))
              (types
                (type
                  (generic_type
                    (type_name
                      (name "Thenable"))
                    (type_parameters
                      (parameter_types
                        (parameter_type
                          (basic_type "boolean"))))))))
            (comment__
              ""
              ""
              "		/**"
              '		 * Insert a {@link SnippetString snippet} and put the editor into snippet mode. "Snippet mode"'
              "		 * means the editor adds placeholders and additional cursors so that the user can complete"
              "		 * or accept the snippet."
              "		 *"
              "		 * @param snippet The snippet to insert in this edit."
              "		 * @param location Position or range at which to insert the snippet, defaults to the current editor selection or selections."
              "		 * @param options The undo/redo behavior around this edit. By default, undo stops will be created before and after this edit."
              "		 * @returns A promise that resolves with a value indicating if the snippet could be inserted. Note that the promise does not signal"
              "		 * that the snippet is completely filled-in or accepted."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "insertSnippet")
              (arg_list
                (argument
                  (identifier "snippet")
                  (types
                    (type
                      (type_name
                        (name "SnippetString")))))
                (argument
                  (identifier "location")
                  (optional "?")
                  (types
                    (type
                      (type_name
                        (name "Position")))
                    (type
                      (type_name
                        (name "Range")))
                    (type
                      (readonly "readonly")
                      (array_of
                        (array_types
                          (array_type
                            (type_name
                              (name "Position"))))))
                    (type
                      (readonly "readonly")
                      (array_of
                        (array_types
                          (array_type
                            (type_name
                              (name "Range"))))))))
                (argument
                  (identifier "options")
                  (optional "?")
                  (types
                    (type
                      (declarations_block
                        (comment__
                          ""
                          "			/**"
                          "			 * Add undo stop before making the edits."
                          "			 */"
                          "			")
                        (declaration
                          (qualifiers
                            (readonly "readonly"))
                          (identifier "undoStopBefore")
                          (types
                            (type
                              (basic_type "boolean"))))
                        (comment__
                          ""
                          "			/**"
                          "			 * Add undo stop after making the edits."
                          "			 */"
                          "			")
                        (declaration
                          (qualifiers
                            (readonly "readonly"))
                          (identifier "undoStopAfter")
                          (types
                            (type
                              (basic_type "boolean"))))
                        (comment__
                          ""
                          "			/**"
                          "			 * Keep whitespace of the {@link SnippetString.value} as is."
                          "			 */"
                          "			")
                        (declaration
                          (qualifiers
                            (readonly "readonly"))
                          (identifier "keepWhitespace")
                          (optional "?")
                          (types
                            (type
                              (basic_type "boolean")))))))))
              (types
                (type
                  (generic_type
                    (type_name
                      (name "Thenable"))
                    (type_parameters
                      (parameter_types
                        (parameter_type
                          (basic_type "boolean"))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Adds a set of decorations to the text editor. If a set of decorations already exists with"
              "		 * the given {@link TextEditorDecorationType decoration type}, they will be replaced. If"
              "		 * `rangesOrOptions` is empty, the existing decorations with the given {@link TextEditorDecorationType decoration type}"
              "		 * will be removed."
              "		 *"
              "		 * @see {@link window.createTextEditorDecorationType createTextEditorDecorationType}."
              "		 *"
              "		 * @param decorationType A decoration type."
              "		 * @param rangesOrOptions Either {@link Range ranges} or more detailed {@link DecorationOptions options}."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "setDecorations")
              (arg_list
                (argument
                  (identifier "decorationType")
                  (types
                    (type
                      (type_name
                        (name "TextEditorDecorationType")))))
                (argument
                  (identifier "rangesOrOptions")
                  (types
                    (type
                      (readonly "readonly")
                      (array_of
                        (array_types
                          (array_type
                            (type_name
                              (name "Range"))))))
                    (type
                      (readonly "readonly")
                      (array_of
                        (array_types
                          (array_type
                            (type_name
                              (name "DecorationOptions")))))))))
              (types
                (type
                  (basic_type "void"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Scroll as indicated by `revealType` in order to reveal the given range."
              "		 *"
              "		 * @param range A range."
              "		 * @param revealType The scrolling strategy for revealing `range`."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "revealRange")
              (arg_list
                (argument
                  (identifier "range")
                  (types
                    (type
                      (type_name
                        (name "Range")))))
                (argument
                  (identifier "revealType")
                  (optional "?")
                  (types
                    (type
                      (type_name
                        (name "TextEditorRevealType"))))))
              (types
                (type
                  (basic_type "void"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Show the text editor."
              "		 *"
              "		 * @deprecated Use {@link window.showTextDocument} instead."
              "		 *"
              "		 * @param column The {@link ViewColumn column} in which to show this editor."
              "		 * This method shows unexpected behavior and will be removed in the next major update."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "show")
              (arg_list
                (argument
                  (identifier "column")
                  (optional "?")
                  (types
                    (type
                      (type_name
                        (name "ViewColumn"))))))
              (types
                (type
                  (basic_type "void"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Hide the text editor."
              "		 *"
              "		 * @deprecated Use the command `workbench.action.closeActiveEditor` instead."
              "		 * This method shows unexpected behavior and will be removed in the next major update."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "hide")
              (types
                (type
                  (basic_type "void"))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * Represents an end of line character sequence in a {@link TextDocument document}."
          "	 */"
          "	")
        (enum
          (identifier "EndOfLine")
          (comment__
            ""
            "		/**"
            "		 * The line feed `\n` character."
            "		 */"
            "		")
          (item
            (identifier "LF")
            (literal
              (integer "1")))
          (comment__
            ""
            "		/**"
            "		 * The carriage return line feed `\r\n` sequence."
            "		 */"
            "		")
          (item
            (identifier "CRLF")
            (literal
              (integer "2"))))
        (comment__
          ""
          ""
          "	/**"
          "	 * A complex edit that will be applied in one transaction on a TextEditor."
          "	 * This holds a description of the edits and if the edits are valid (i.e. no overlapping regions, document was not changed in the meantime, etc.)"
          "	 * they can be applied on a {@link TextDocument document} associated with a {@link TextEditor text editor}."
          "	 */"
          "	")
        (interface
          (identifier "TextEditorEdit")
          (declarations_block
            (comment__
              ""
              "		/**"
              "		 * Replace a certain text region with a new value."
              "		 * You can use `\r\n` or `\n` in `value` and they will be normalized to the current {@link TextDocument document}."
              "		 *"
              "		 * @param location The range this operation should remove."
              "		 * @param value The new text this operation should insert after removing `location`."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "replace")
              (arg_list
                (argument
                  (identifier "location")
                  (types
                    (type
                      (type_name
                        (name "Position")))
                    (type
                      (type_name
                        (name "Range")))
                    (type
                      (type_name
                        (name "Selection")))))
                (argument
                  (identifier "value")
                  (types
                    (type
                      (basic_type "string")))))
              (types
                (type
                  (basic_type "void"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Insert text at a location."
              "		 * You can use `\r\n` or `\n` in `value` and they will be normalized to the current {@link TextDocument document}."
              "		 * Although the equivalent text edit can be made with {@link TextEditorEdit.replace replace}, `insert` will produce a different resulting selection (it will get moved)."
              "		 *"
              "		 * @param location The position where the new text should be inserted."
              "		 * @param value The new text this operation should insert."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "insert")
              (arg_list
                (argument
                  (identifier "location")
                  (types
                    (type
                      (type_name
                        (name "Position")))))
                (argument
                  (identifier "value")
                  (types
                    (type
                      (basic_type "string")))))
              (types
                (type
                  (basic_type "void"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Delete a certain text region."
              "		 *"
              "		 * @param location The range this operation should remove."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "delete")
              (arg_list
                (argument
                  (identifier "location")
                  (types
                    (type
                      (type_name
                        (name "Range")))
                    (type
                      (type_name
                        (name "Selection"))))))
              (types
                (type
                  (basic_type "void"))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Set the end of line sequence."
              "		 *"
              "		 * @param endOfLine The new end of line for the {@link TextDocument document}."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "setEndOfLine")
              (arg_list
                (argument
                  (identifier "endOfLine")
                  (types
                    (type
                      (type_name
                        (name "EndOfLine"))))))
              (types
                (type
                  (basic_type "void"))))))
        (comment__
          ""
          ""
          "	/**"
          "	 * A universal resource identifier representing either a file on disk"
          "	 * or another resource, like untitled resources."
          "	 */"
          "	")
        (interface
          (identifier "Uri")
          (declarations_block
            (comment__
