    (interface
      (identifier "WorkspaceEdit")
      (declarations_block
        (comment__
          ""
          "	/**"
          "	 * Holds changes to existing resources."
          "	 */"
          "	")
        (declaration
          (qualifiers)
          (identifier "changes")
          (optional "?")
          (types
            (type
