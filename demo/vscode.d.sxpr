              "		 * not the background color of the hint itself. That means padding can be used to visually"
              "		 * align/separate an inlay hint."
              "		 */"
              "		")
            (declaration
              (qualifiers)
              (identifier "paddingRight")
              (optional "?")
              (types
                (type
                  (basic_type "boolean"))))
            (comment__
