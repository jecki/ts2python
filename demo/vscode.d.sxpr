                  (types
                    (type
                      (type_name
                        (name "CancellationToken"))))))
              (types
                (type
                  (generic_type
                    (type_name
                      (name "ProviderResult"))
                    (type_parameters
                      (parameter_types
                        (parameter_type
                          (type_name
                            (name "LanguageModelToolResult")))))))))
            (comment__
              ""
              ""
              "		/**"
              "		 * Called once before a tool is invoked. It's recommended to implement this to customize the progress message that appears"
              "		 * while the tool is running, and to provide a more useful message with context from the invocation input. Can also"
              "		 * signal that a tool needs user confirmation before running, if appropriate."
              "		 *"
              "		 * * *Note 1:* Must be free of side-effects."
              "		 * * *Note 2:* A call to `prepareInvocation` is not necessarily followed by a call to `invoke`."
              "		 */"
              "		")
            (function
              (qualifiers)
              (identifier "prepareInvocation")
              (optional "?")
              (arg_list
                (argument
                  (identifier "options")
                  (types
                    (type
                      (generic_type
                        (type_name
                          (name "LanguageModelToolInvocationPrepareOptions"))
                        (type_parameters
                          (parameter_types
                            (parameter_type
                              (type_name
                                (name "T")))))))))
                (argument
                  (identifier "token")
                  (types
                    (type
                      (type_name
                        (name "CancellationToken"))))))
              (types
                (type
                  (generic_type
                    (type_name
                      (name "ProviderResult"))
                    (type_parameters
                      (parameter_types
                        (parameter_type
                          (type_name
                            (name "PreparedToolInvocation")))))))))))
        (comment__
          ""
          ""
          "	/**"
